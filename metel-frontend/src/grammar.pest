// Metel v0.1 PEG grammar for pest
// Reference: docs/Metel/spec/Language Spec.md §2–§12
//
// Convention:
//   SCREAMING_SNAKE_CASE = silent / atomic rules (pest built-ins or terminals)
//   snake_case           = regular rules that produce pairs in the parse tree
//   keywords are matched as atomic rules to avoid consuming identifier prefixes
//
// Ordering invariant:
//   `stmt` is tried before binding declarations in `decl` so that `let_x = 5;`
//   is an assignment, not a declaration.
//
//   `return`/`break`/`continue` are expressions (issue #229), living in
//   `primary_expr` alongside `if`/`loop`/`match`. Unlike those three, their
//   trailing component is optional (`return_expr`/`break_expr`) or absent
//   entirely (`continue_expr`), so a prefix match like `"break"` followed by
//   garbage can't be forced to fail-and-backtrack the way `"loop"` followed by
//   non-`block` input can. Each rule therefore carries its own explicit
//   word-boundary lookahead (`!(ASCII_ALPHANUMERIC | "_")`), matching the
//   convention already used for `std_kw`/`self_kw`/`super_kw` and `keyword`
//   below — correct regardless of alternation order, so `break_sum`/
//   `return_value`/`continued` are never mis-parsed as a keyword plus garbage.

// ── Whitespace and comments ───────────────────────────────────────────────────

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
COMMENT    = _{ line_comment | block_comment }

line_comment  = _{ "//" ~ (!"\n" ~ ANY)* }
block_comment = _{ "/*" ~ (!"*/" ~ ANY)* ~ "*/" }

// ── Program ───────────────────────────────────────────────────────────────────

program = { SOI ~ (import_decl | export_decl)* ~ decl* ~ EOI }

// ── Module header ─────────────────────────────────────────────────────────────

import_decl = { "import" ~ import_path ~ ";" }
export_decl = { "export" ~ import_path ~ ";" }
import_path = { path_root ~ "::" ~ import_tree }
path_root   = { root_kw | std_kw | self_kw | super_kw | ident }
import_tree = {
    ident ~ "as" ~ ident
  | ident ~ "::" ~ import_tree
  | "{" ~ import_item ~ ("," ~ import_item)* ~ ","? ~ "}"
  | "*"
  | ident
}
import_item = { ident ~ ("as" ~ ident)? }

decl = {
    fun_decl
  | struct_decl
  | enum_decl
  | type_alias     // RFC-0160: `type Name := T;` at module or block scope. `type … := …`
  | impl_block     //   inside aspect/extend is `assoc_type_def` — a different position.
  | aspect_decl
  | stmt          // before let-bindings so that let_x=5 is an assignment
  | let_mut_decl
  | let_decl
}

// RFC-0160: a transparent type alias. `:=` per RFC-0136 (the alias name is a kept
// binding), matching `assoc_type_def`. Reachable through `decl` at module scope and,
// via `block_item`, inside a function / block body.
type_alias = { pub_kw? ~ "type" ~ ident ~ generic_params? ~ ":=" ~ type_expr ~ ";" }

// RFC-0136: the initializer separator is `:=` (a kept binding). Old `=` here is
// a hard parse error, no alias. Type annotation stays `:`.
let_decl     = { "let" ~ !mut_kw ~ ident ~ (":" ~ type_expr)? ~ ":=" ~ expr ~ ";" }
let_mut_decl = { ("let" ~ mut_kw | mut_kw) ~ ident ~ (":" ~ type_expr)? ~ ":=" ~ expr ~ ";" }

fun_decl    = { native_attr? ~ pub_kw? ~ "fun" ~ ident ~ generic_params? ~ "(" ~ param_list? ~ ")" ~ ("->" ~ type_expr)? ~ where_clause? ~ (block | ";") }
// Stdlib-only host-binding attribute: `native(@std.core.print) fun print(...);`
// The stdlib-only restriction is enforced after parsing (name resolution), not here.
native_attr = { "native" ~ "(" ~ "@" ~ native_path ~ ")" }
// Raw dotted path; segments may be keywords (e.g. `std`), so this does not
// reuse `ident` (which excludes keywords).
native_path = @{ native_seg ~ ("." ~ native_seg)* }
native_seg  = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

struct_decl = { pub_kw? ~ "struct" ~ ident ~ generic_params? ~ where_clause? ~ "{" ~ struct_fields ~ "}" }
struct_fields = { (struct_field ~ ",")* ~ struct_field? }
struct_field  = { pub_kw? ~ ident ~ ":" ~ type_expr }

enum_decl   = { pub_kw? ~ "enum" ~ ident ~ generic_params? ~ where_clause? ~ "{" ~ enum_variants ~ "}" }
enum_variants = { (enum_variant ~ ",")* ~ enum_variant? }
enum_variant  = { ident ~ ("{" ~ struct_fields ~ "}")? }

// `bang?` (not a raw `"!"?`) so polarity is structurally detectable in Rust code.
impl_block          = { extend_impl_block }
extend_impl_block   = { "extend" ~ generic_params? ~ type_expr ~ (extend_impl_bodyless | extend_impl_braced) }
extend_impl_bodyless = { ":" ~ extend_aspect_list ~ where_clause? ~ ";" }
extend_impl_braced   = { (":" ~ extend_aspect)? ~ where_clause? ~ "{" ~ (assoc_type_def | fun_decl)* ~ "}" }
extend_aspect_list   = { extend_aspect ~ ("," ~ extend_aspect)* }
extend_aspect        = { bang? ~ named_type }
// RFC-0136: an associated-type *definition* introduces `ident` into the impl's
// namespace (kept), so `:=`. Use-site `assoc_binding` (`Deref<Target = Node>`)
// selects a pre-declared slot and keeps `=`.
assoc_type_def = { "type" ~ ident ~ ":=" ~ type_expr ~ ";" }

aspect_decl  = { pub_kw? ~ "aspect" ~ ident ~ generic_params? ~ (";" | "{" ~ (assoc_type_decl | aspect_method)* ~ "}") }
aspect_method = { "fun" ~ ident ~ generic_params? ~ "(" ~ param_list? ~ ")" ~ ("->" ~ type_expr)? ~ (block | ";") }
assoc_type_decl = { "type" ~ ident ~ (":" ~ bound_list)? ~ ";" }

// ── Parameters ────────────────────────────────────────────────────────────────

param_list = { param ~ ("," ~ param)* ~ ","? }
param      = { ("&" ~ mut_kw? ~ "self") | "self" | (ident ~ (":" ~ type_expr)?) }

generic_params   = { "<" ~ generic_param ~ ("," ~ generic_param)* ~ ">" }
generic_param    = { record_kw? ~ ident ~ (":" ~ bound_list)? }
// A bound is always an aspect name (+ optional generics/assoc-bindings), never a
// full `type_expr` — so `bound_head` starts from `type_path`, not `type_expr`, and
// never risks `type_expr`'s own `never_type = { "!" }` alternative swallowing a
// leading "!" as a bound in its own right (which `bound`'s own explicit `bang` token
// already consumes first, same convention as `mut_kw` in `param` above).
// `bound_head` deliberately doesn't reuse `named_type`/`type_args`: ordinary type
// instantiation (`List<i64>`) must never accept `Key = Value`, and bounds need to mix
// ordinary args and assoc-bindings (`Iterator<Item = i64>`).
bound_list    = { bound ~ ("+" ~ bound)* }
bound         = { bang? ~ bound_head }
bang          = { "!" }
bound_head    = { row_bound | type_path ~ ("<" ~ bound_arg ~ ("," ~ bound_arg)* ~ ","? ~ ">")? }
row_bound     = { "{" ~ (row_field ~ ("," ~ row_field)*)? ~ ("," ~ "..")? ~ ","? ~ "}" }
row_field     = { ident ~ (":" ~ type_expr)? }
bound_arg     = { assoc_binding | type_expr }
assoc_binding = { ident ~ "=" ~ type_expr }
where_clause     = { "where" ~ where_constraint ~ ("," ~ where_constraint)* }
where_constraint = { record_kw? ~ ident ~ ":" ~ bound_list }

// ── Statements ────────────────────────────────────────────────────────────────

stmt = {
    while_stmt
  | for_stmt
  | for_in_stmt
  | expr_stmt
}

block      = { "{" ~ block_item* ~ expr? ~ "}" }
// block_item wraps each statement-level item. block_expr_stmt handles `if`,
// `match`, and `loop` in statement position with an optional trailing `;`. The
// !"}" lookahead keeps the tail-expression case for `expr?`; if the optional
// `;` was consumed and `}` follows, pest backtracks and `expr_stmt` takes over.
block_item      = { block_expr_stmt | decl }
block_expr_stmt = { (if_expr | match_expr | loop_expr) ~ ";"? ~ !"}" }
expr_stmt  = { expr ~ ";" }

while_stmt = { "while" ~ "(" ~ expr ~ ")" ~ block }

for_stmt   = { "for" ~ "(" ~ for_init ~ expr? ~ ";" ~ expr? ~ ")" ~ block }
for_init   = { expr_stmt | let_mut_decl | let_decl | ";" }

for_in_stmt  = { "for" ~ "(" ~ (("let" ~ mut_kw?) | mut_kw)? ~ ident ~ "in" ~ expr ~ ")" ~ block }

// ── Expressions (precedence via layering) ─────────────────────────────────────

expr             = { assign_expr }

// Entry point for re-parsing a standalone expression substring (string
// interpolation's `${...}` body). `expr` alone has no leading `~` sequence
// member for pest to hang implicit whitespace-skipping off of when it is the
// *outermost* rule passed to `Parser::parse` — `program`'s `SOI ~ item*`
// gets that skip for free, `expr` on its own does not. Without this wrapper,
// `${ 1 + 1 }` (leading space) fails to parse while `${1 + 1}` (no leading
// space) succeeds.
interp_expr_entry = { SOI ~ expr ~ EOI }

assign_expr      = { unary_expr ~ assign_op ~ assign_expr | or_expr }
// RFC-0136: plain reassignment reassigns a kept binding, so `:=`. The compound
// operators keep `=` — the token already signals an in-place update of existing
// storage. `==` is unaffected (it is never `assign_op`).
assign_op        = { "+=" | "-=" | "*=" | "/=" | "%=" | ":=" }

or_expr          = { and_expr ~ (or_op ~ and_expr)* }
or_op            = { "||" }
and_expr         = { cmp_expr ~ (and_op ~ cmp_expr)* }
and_op           = { "&&" }
cmp_expr         = { range_expr ~ (cmp_op ~ range_expr)? }
cmp_op           = { "==" | "!=" | "<=" | ">=" | "<" | ">" }

range_expr       = { add_expr ~ (range_op ~ add_expr)? }
range_op         = { "..=" | ".." }

add_expr         = { mul_expr ~ (add_op ~ mul_expr)* }
add_op           = { "+" | "-" }
mul_expr         = { cast_expr ~ (mul_op ~ cast_expr)* }
mul_op           = { "*" | "/" | "%" }
cast_expr        = { asc_expr ~ (cast_op ~ type_expr)* }
cast_op          = { "as" }
asc_expr         = { unary_expr ~ (":" ~ type_expr)? }
// RFC-0110: unary `*` (dereference). No ambiguity with binary `*` (`mul_op`): that only
// ever runs *between* two already-parsed operands inside `mul_expr`'s repetition, and
// `unary_expr` sits below `mul_expr` in the precedence chain, so a leading `*` is always
// consumed as the prefix first. Postfix binds tighter, so `*p.field` is `*(p.field)`.
unary_expr       = { ("!" | "-" | "*" | "&" ~ mut_kw?) ~ unary_expr | postfix_expr }

postfix_expr     = { primary_expr ~ postfix* }
postfix          = {
    "::<" ~ type_args ~ ">" ~ "(" ~ arg_list? ~ ")"              // turbofish call
  | "(" ~ arg_list? ~ ")"                                         // function call
  | "." ~ decimal_int                                             // tuple access (.0, .1, ...)
  | "." ~ ident ~ "::<" ~ type_args ~ ">" ~ "(" ~ arg_list? ~ ")"  // method call with turbofish
  | "." ~ ident ~ "(" ~ arg_list? ~ ")"                           // method call
  | "." ~ ident                                                    // field access
  | "[" ~ expr ~ "]"                                              // index
  | "?"                                                           // error propagation
}

arg_list = { expr ~ ("," ~ expr)* ~ ","? }

primary_expr = {
    float_lit_suffixed  // must come before float_lit — "3.14f32" would match float "3.14" first otherwise
  | float_lit           // must come before int_lit_suffixed and int_lit
  | int_lit_suffixed    // must come before int_lit — "42u8" would match int "42" first otherwise
  | int_lit
  | string_lit
  | char_lit
  | bool_lit
  | closure_expr
  | unit_lit
  | tuple_or_paren
  | repeat_array  // must come before array_lit — both start with "["
  | array_lit
  | match_expr
  | if_expr
  | loop_expr
  | return_expr
  | break_expr
  | continue_expr
  | record_projection_expr
  | record_lit
  | struct_literal
  | path_expr
}

// Issue #229: `return`/`break`/`continue` as first-class expressions of type `!`,
// reachable anywhere an expression is (block tail, braceless if-arm, match arm,
// nested position) via the ordinary `!` subtyping rule (RFC-0078). The keyword
// itself is a separate atomic (`@`) sub-rule, like `std_kw`/`self_kw`/`super_kw`
// above — needed because a *non*-atomic rule (plain `{ }`) auto-inserts
// whitespace between `~`-separated components, which would skip right past a
// space before the word-boundary lookahead ran and check the wrong position
// (e.g. `return Foo { .. }` would see the guard test "F", not the space right
// after "return", wrongly rejecting it as if "return" were immediately
// followed by an identifier character).
return_expr   = { return_kw ~ expr? }
break_expr    = { break_kw ~ expr? }
continue_expr = { continue_kw }
return_kw     = @{ "return" ~ !(ASCII_ALPHANUMERIC | "_") }
break_kw      = @{ "break" ~ !(ASCII_ALPHANUMERIC | "_") }
continue_kw   = @{ "continue" ~ !(ASCII_ALPHANUMERIC | "_") }

tuple_or_paren = { "(" ~ expr ~ ("," ~ expr)+ ~ ")" | "(" ~ expr ~ ")" }
repeat_array   = { "[" ~ expr ~ ";" ~ decimal_int ~ "]" }
array_lit      = { "[" ~ (expr ~ ("," ~ expr)* ~ ","?)? ~ "]" }

// RFC-0078 §3.1: a match on a `!`-typed scrutinee is vacuously exhaustive with
// zero arms — the arm list is optional to allow `match (x) { }`.
// RFC-0156: the scrutinee must be parenthesized, matching if/while/for. The bare
// `match x { }` form is a parse error. `tuple_or_paren` keeps a tuple scrutinee
// (`match (a, b) { }`) working; `unit_lit` keeps `match () { }` — `()` is not a
// `tuple_or_paren`. Both alternatives feed `parse_expr` unchanged.
match_scrutinee = _{ unit_lit | tuple_or_paren }
match_expr  = { "match" ~ match_scrutinee ~ "{" ~ (match_arm ~ ("," ~ match_arm)* ~ ","?)? ~ "}" }
// return_expr/break_expr/continue_expr are reachable through plain `expr` now
// (issue #229) — no more return_arm/break_arm special-case needed here.
match_arm   = { pattern ~ ("if" ~ expr)? ~ "=>" ~ (block | expr) }

if_expr     = { "if" ~ "(" ~ expr ~ ")" ~ (block | expr) ~ ("else" ~ (if_expr | block | expr))? }
loop_expr   = { "loop" ~ block }

// RFC-0154: the parameter list is pipe-delimited (`|x, y|`), freeing `(...)` for
// grouping/tuples. `|...|` self-disambiguates a closure from a grouped expression, so
// the `->` that RFC-0041 required before every body is now written only with a return
// type (`("->" ~ type_expr)?`, not `"->" ~ type_expr?`). Nullary is `|| { ... }` — the
// `or_op = "||"` alternative is only reachable in `or_expr`'s repetition, never at
// operand start, so there is no ambiguity and no lexer hack.
closure_expr = { capture_list? ~ once_kw? ~ mut_kw? ~ "|" ~ param_list? ~ "|" ~ ("->" ~ type_expr)? ~ block }
capture_list = { "[" ~ (capture_item ~ ("," ~ capture_item)* ~ ","?)? ~ "]" }
capture_item = { "&" ~ mut_kw ~ ident | "&" ~ ident | ident ~ "." ~ clone_kw ~ "(" ~ ")" | ident }

struct_literal = { type_path ~ "{" ~ (field_init ~ ("," ~ field_init)* ~ ","?)? ~ "}" }
record_lit = { "{" ~ (field_init ~ ("," ~ field_init)* ~ ","?)? ~ "}" }
record_projection_expr = { type_path ~ ".{" ~ ident ~ ("," ~ ident)* ~ ","? ~ "}" }
field_init     = { ident ~ ("=" ~ expr)? }

path_expr = { path_root ~ ("::" ~ ident)* }
type_path = { path_root ~ ("::" ~ ident)* }

// ── Patterns ──────────────────────────────────────────────────────────────────

pattern = {
    ("_" ~ !(ASCII_ALPHANUMERIC | "_"))   // wildcard — must not match _foo
  | array_pattern                         // must come before tuple_pattern
  | tuple_pattern
  | record_pattern
  | enum_pattern
  | literal_pattern
  | bind_pattern
}

tuple_pattern   = { "(" ~ pattern ~ ("," ~ pattern)* ~ ")" }
array_pattern   = { "[" ~ array_pat_body ~ "]" }
array_pat_body  = { (pattern ~ ("," ~ pattern)* ~ ("," ~ rest_pat)? | rest_pat)? }
rest_pat        = { ".." ~ ident }
// RFC-0032 §4/§5: a bare `..` (never binding a name, unlike array's `rest_pat`) omits
// the fields not named, so an external pattern can skip private fields it isn't
// allowed to name. Always last, never followed by a trailing comma.
record_rest     = { ".." }
field_pat_list  = { ident ~ ("," ~ ident)* ~ ("," ~ record_rest)? ~ ","? | record_rest }
record_pattern  = { "{" ~ field_pat_list ~ "}" }
enum_pattern    = { ident ~ "::" ~ ident ~ ("{" ~ field_pat_list ~ "}")?           // qualified: Enum::Variant, optional fields
                  | ident ~ "{" ~ field_pat_list ~ "}" }                           // RFC-0107: bare fieldful variant (Some { value })
literal_pattern = { float_lit_suffixed | float_lit | int_lit_suffixed | int_lit | string_lit | char_lit | bool_lit }
bind_pattern    = { ident }

// ── Type expressions ──────────────────────────────────────────────────────────

type_expr = {
    fun_type
  | mut_reference_type
  | reference_type
  | sized_array_type  // must come before array_type — both start with "["
  | array_type        // atom "[]" — must precede the unit/tuple/named atoms it wraps
  | unit_type
  | tuple_type
  | record_projection_type
  | record_type
  | extends_type
  | dyn_type
  | never_type
  | named_type
}

// RFC-0078: `!`, the uninhabited bottom type. No ambiguity with the unary `!`
// (logical-not) operator — type and expression contexts are parsed via entirely
// separate rules. Lowered to `TypeExpr::Named("Never", [])`, the same AST shape
// the pre-existing `Never` identifier spelling already produces.
never_type = { "!" }

// RFC-0130: renamed from `impl_type` (`impl Aspect`). `impl` stays a reserved
// keyword (like `mut`/`pub` post-RFC-0098) so the old spelling gets a clear
// error rather than parsing as an identifier.
extends_type = { "extends" ~ named_type }

// RFC-0008: `dyn Aspect`, an unsized existential type -- the concrete type is
// erased and dispatch happens through a vtable. Mirrors `extends_type`'s shape
// exactly (a keyword applied to a named aspect type); unlike `extends_type`,
// `dyn_type` is a real type, not per-call-site generic sugar, so it is not
// positionally restricted to parameter/return position.
dyn_type = { "dyn" ~ named_type }

unit_type  = { "()" }
tuple_type = { "(" ~ type_expr ~ ("," ~ type_expr)+ ~ ")" }
record_type = { "{" ~ (record_type_field ~ ("," ~ record_type_field)* ~ ","?)? ~ "}" }
record_type_field = { ident ~ ":" ~ type_expr }
record_projection_type = { type_path ~ ".{" ~ ident ~ ("," ~ ident)* ~ ","? ~ "}" }
// RFC-0154: pipe-delimited parameter list. `->` and the return type stay mandatory in a
// written function type (unlike the closure literal above). `fun_type` is `type_expr`'s
// first alternative and now unambiguous — nothing else in `type_expr` starts with `|`
// (or a `once`/`mut` qualifier then `|`).
fun_type   = { fun_type_qualifier* ~ "|" ~ type_list? ~ "|" ~ "->" ~ type_expr }
fun_type_qualifier = { once_kw | mut_kw }
reference_type = { "&" ~ type_expr }
mut_reference_type = { "&" ~ mut_kw ~ type_expr }
sized_array_type = { "[" ~ type_expr ~ ";" ~ decimal_int ~ "]" }
array_type = { array_atom ~ "[]" }
// The element of a postfix `[]` array: a unit, tuple, or named type. Silent so
// the matched inner rule flattens into `array_type` and the parser is unchanged.
array_atom = _{ unit_type | tuple_type | record_projection_type | record_type | extends_type | dyn_type | named_type }
named_type = { type_path ~ ("<" ~ type_args ~ ">")? }
type_args  = { type_expr ~ ("," ~ type_expr)* }
type_list  = { type_expr ~ ("," ~ type_expr)* }

// ── Terminals ─────────────────────────────────────────────────────────────────

int_lit_suffix     = @{ "i8" | "i16" | "i32" | "i64" | "u8" | "u16" | "u32" | "u64" }
float_lit_suffix   = @{ "f32" | "f64" }
int_lit_suffixed   = @{ ASCII_DIGIT+ ~ ("_" ~ ASCII_DIGIT+)* ~ int_lit_suffix }
float_lit_suffixed = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ ~ float_lit_suffix }
int_lit     = @{ ASCII_DIGIT+ ~ ("_" ~ ASCII_DIGIT+)* }
float_lit   = @{ ASCII_DIGIT+ ~ "." ~ ASCII_DIGIT+ }
decimal_int = @{ ASCII_DIGIT+ }

// `${…}` may itself contain a nested string literal with its own unescaped quotes
// (`"${if (c) { "yes" } else { "no" }}"`, an if/match arm producing a string) --
// `interpolation` recurses through balanced `{}` and lets `nested_string` swallow
// such a quoted span whole, so `string_char`'s own bare-quote-terminates rule never
// sees it as the end of the outer literal (#661). `nested_string` does not itself
// recurse into `interpolation` -- a string literal nested inside an interpolated
// expression that itself contains another `${…}` is not handled, matching the scope
// of the reported bug; deeper nesting can extend this rule if it's ever needed.
string_lit    = @{ "\"" ~ string_char* ~ "\"" }
string_char   = _{ interpolation | "\\" ~ escape_seq | (!("\"" | "\\") ~ ANY) }
interpolation = _{ "${" ~ interp_char* ~ "}" }
interp_char   = _{ nested_string | ("{" ~ interp_char* ~ "}") | (!("{" | "}" | "\"") ~ ANY) }
nested_string = _{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
escape_seq    = _{ "n" | "t" | "r" | "\\" | "\"" | "$" }

char_lit      = @{ "'" ~ char_char ~ "'" }
char_char     = _{ "\\" ~ char_escape_seq | (!("'" | "\\") ~ ANY) }
char_escape_seq = _{ "u" ~ "{" ~ ASCII_HEX_DIGIT{1, 6} ~ "}" | "n" | "t" | "r" | "\\" | "'" }

bool_lit  = @{ ("true" | "false") ~ !(ASCII_ALPHANUMERIC | "_") }
unit_lit  = @{ "()" }

pub_kw   = @{ "public" ~ !(ASCII_ALPHANUMERIC | "_") }
mut_kw   = @{ "var" ~ !(ASCII_ALPHANUMERIC | "_") }
once_kw  = @{ "once" ~ !(ASCII_ALPHANUMERIC | "_") }
clone_kw = @{ "clone" ~ !(ASCII_ALPHANUMERIC | "_") }
root_kw  = @{ "root" ~ !(ASCII_ALPHANUMERIC | "_") }
std_kw   = @{ "std" ~ !(ASCII_ALPHANUMERIC | "_") }
self_kw  = @{ "self" ~ !(ASCII_ALPHANUMERIC | "_") }
super_kw = @{ "super" ~ !(ASCII_ALPHANUMERIC | "_") }
record_kw = @{ "record" ~ !(ASCII_ALPHANUMERIC | "_") }

// arch-implements: ["arch.parsing.requirement-5"]
ident = @{
    !keyword ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

// arch-implements: ["arch.parsing.requirement-5"]
keyword = @{
    ("and" | "as" | "aspect" | "break" | "continue" | "dyn" | "else" | "enum" |
     "export" | "extend" | "extends" | "false" | "for" | "fun" | "if" | "impl" |
     "import" | "let" | "loop" | "match" | "mut" | "once" | "or" | "pub" |
     "public" | "return" | "root" | "self" | "std" | "struct" | "super" |
     "true" | "var" | "record" |
     "where" | "while")
    ~ !(ASCII_ALPHANUMERIC | "_")
}
