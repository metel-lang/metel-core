// std::process — command-line arguments and subprocess execution
// (METEL-166, RFC-0057).
//
// An explicit (not auto-imported) host module: programs must `import std::process`.
// The subprocess model is synchronous and shell-free: `run` takes the command
// and its arguments separately, so quoting and shell expansion never apply.
// Streaming pipes, background processes, and shell helpers are deferred.

// The captured result of a finished subprocess.
public struct ProcessOutput {
    // The exit status code (-1 if the process was terminated by a signal).
    public status: i64,
    // Everything the process wrote to standard output.
    public stdout: String,
    // Everything the process wrote to standard error.
    public stderr: String,
}

// The process command-line arguments (the full argv, including the interpreter
// and script path for the first cut).
native(@std.process.args) public fun args() -> [String];

// Run `command` with `args` to completion and capture its output. The command
// is executed directly, not through a shell.
native(@std.process.run) public fun run(command: String, args: [String]) -> Result<ProcessOutput, OsError>;
