}

extend String: Display {
    native(@std.core.to_string) fun to_string(&self) -> String;
}

extend String: Clone {
    fun clone(&self) -> Self {
        return self;
    }
}

extend<T: Display> [T]: Display {
    fun to_string(&self) -> String {
        var out := "[";
        var first := true;
        for (item in self) {
            if (!first) {
                out := out + ", ";
            }
            out := out + item.to_string();
            first := false;
        }
        return out + "]";
    }
}

extend<T: Clone> [T]: Clone {
    fun clone(&self) -> Self {
        return self;
    }
}

extend<T: Eq> [T]: Eq {
    fun eq(&self, other: &Self) -> boolean {
        var other_len := 0;
        for (_ in other) {
            other_len += 1;
        }
        if (self.len() != other_len) {
            return false;
        }
        var i := 0;
        while (i < self.len()) {
            if (!__eq_array_item(self[i as u64], other[i as u64])) {
                return false;
            }
            i += 1;
        }
        return true;
    }
}

