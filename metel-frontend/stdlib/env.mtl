// std::env — host process environment inspection (METEL-164, RFC-0057).
//
// An explicit (not auto-imported) host module: programs must `import std::env`.
// Read-only for the first cut; mutating the process environment (set_var /
// remove_var) is deferred.

// A single environment variable: its name and value.
public struct EnvVar {
    public name: String,
    public value: String,
}

// The value of environment variable `name`, or `None` if it is unset (or not
// valid Unicode).
native(@std.env.get) public fun get(name: String) -> Perhaps<String>;

// Every environment variable. Wrap in `List::from` for the List ergonomics.
native(@std.env.vars) public fun vars() -> [EnvVar];
