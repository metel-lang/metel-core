// Stage 6: enum declaration, construction, and pattern matching.

// User-defined enum with unit variants
enum Direction {
    North,
    South,
    East,
    West,
}

let d: Direction := Direction::North;

// User-defined enum with field variants
enum Shape {
    Circle { radius: f64 },
    Rectangle { width: f64, height: f64 },
}

let s1: Shape := Shape::Circle { radius = 5.0 };
let s2: Shape := Shape::Rectangle { width = 3.0, height = 4.0 };

// Match on user enum
let area: f64 := match (s1) {
    Shape::Circle { radius } => radius * radius,
    Shape::Rectangle { width, height } => width * height,
};

// Built-in Option<T>
let some_val: Option<i64> := Option::Some { value = 42 };
let no_val: Option<i64> := Option::None;

// Match on Option
let result_int: i64 := match (some_val) {
    Option::Some { value } => value,
    None => 0,
};

// Built-in Result<T, E>
let ok_val: Result<i64, String> := Result::Ok { value = 10 };
let err_val: Result<i64, String> := Result::Err { error = "oops" };

// Match on Result
let extracted: i64 := match (ok_val) {
    Result::Ok { value } => value,
    Result::Err { error } => 0,
};
