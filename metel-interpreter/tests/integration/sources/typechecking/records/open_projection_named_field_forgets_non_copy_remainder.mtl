// The forget rule still applies to a projection that names fields: `Handle.{ fd, ..R }` given a
// whole `Handle` would silently drop `name`, which is not `Copy` (RFC-0121 section 4).
struct Handle { fd: i64, name: String }

fun read_fd<row R>(h: Handle.{ fd, ..R }) -> i64 { h.fd }

fun main() {
    let h := Handle { fd = 3, name = "x".to_string() };
    assert(read_fd(h) == 3); // ERROR[T0033]
}
