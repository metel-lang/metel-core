// metel-core#1617 (v0.14.1 integration session): a method call on a function value reaches the T0003 wording even through a local binding (#1242 x #1578).

fun f() -> i64 { 1 }

// A written function type is move-only and has no `Clone` (RFC-0166, RFC-0206 section 2); an inferred
// function or closure value that is `Copy` does (the compiler provides it, metel-core#1805).
fun main() {
    let g: || -> i64 := f;
    let h := g.clone();
}
