// Regression (metel-core#857, RFC-0137 slice 1's own normalization rule, and
// RFC-0137 sec3's worked example): a projection naming every field a struct
// declares normalizes back to the plain struct type rather than staying a
// distinct branded residual. Confirms the normalization doesn't accidentally
// earn row-bound eligibility -- h.{ fd, name }, full width, is rejected by a row
// bound the exact same way a bare `Handle` value already is.

struct Handle { fd: i64, name: String }

fun wants_a_record<record T: { fd: i64, name: String, .. }>(t: T) -> i64 { t.fd }

fun main() {
    let h := Handle(fd = 3, name = "x");
    let _ := wants_a_record(h.{ fd, name });
}
