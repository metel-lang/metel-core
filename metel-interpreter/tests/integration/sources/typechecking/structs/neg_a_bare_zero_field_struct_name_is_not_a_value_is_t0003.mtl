// RFC-0100 section 7: a zero-field struct is built by call, `Unit()`, like any other. Its bare name
// constructs nothing; the bare-name construction RFC-0106 allowed is retired.
//
// metel-core#1577 had a bare name fall back from the value namespace to the zero-field struct of
// its name; metel-core#2198 (RFC-0100) moved a struct-and-function-of-one-name example to
// neg_struct_and_function_of_one_name_is_t0037.mtl.
struct Unit {}

fun main() {
    let v := Unit();
    let u := Unit;
}
