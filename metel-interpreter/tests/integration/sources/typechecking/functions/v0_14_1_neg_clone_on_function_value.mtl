// metel-core#1242: a function type satisfies no aspect, so `.clone()` has nothing to dispatch to.
// The message names that, not "cannot infer receiver type ... add a type annotation", which sent the
// user to an annotation the receiver already had.
fun main() {
    let f: |i64| -> i64 := |x: i64| -> i64 { x + 1 };
    let g: |i64| -> i64 := f.clone();
}
