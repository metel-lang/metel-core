// Test: let-polymorphism of a generic function
//
// `identity` declares its type parameter, so it is generalized into a TypeScheme
// (RFC-0193: a named function writes its signature, it does not infer one).
// Each call site gets a fresh instantiation, so the same function can be used at
// different types independently.
//
// identity has type: forall T. (T) -> T
//
// At each call site:
//   a = identity(42)    -- instantiates to (i64) -> i64,  a : i64
//   b = identity(true)  -- instantiates to (boolean) -> boolean, b : boolean
//   c = identity("hi")  -- instantiates to (String) -> String, c : String
//
// The two calls do NOT interfere -- they bind different fresh type variables.

fun identity<T>(x: T) -> T {
    x
}

let a := identity(42);
let b := identity(true);
let c := identity("hi");
