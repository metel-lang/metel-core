// RFC-0224 section 2 (recursion): a declaration that names itself through a reference reaches a fixed point; the
// reference depends on nothing, so the cycle adds no parameter.
copy struct Node<T> { v: T, parent: &Node<T> }
struct Ring<T> derives Copy { head: Node<T> }

fun ok<T: Copy>(r: Ring<T>) -> (Ring<T>, Ring<T>) { (r, r) }

fun bad<T>(r: Ring<T>) {
    let first := r;
    let again := r; // ERROR[T0019]
}

fun main() {}
