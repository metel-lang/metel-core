// metel-core#2013: the receiver's type carries the closure's contract where the method's own type writes a function type.
copy struct Holder<T> { inner: T }
extend Holder<T> {
    fun get(self) -> T { self.inner }
    fun identity(self, x: T) -> T { x }
}
fun f<T: Copy>(x: T) {
    let c := [x]|k: i64| -> i64 { k };
    let h := Holder { inner = c };
    let d := h.get();
    let a := d;
    let b := d;
}
fun main() {}
