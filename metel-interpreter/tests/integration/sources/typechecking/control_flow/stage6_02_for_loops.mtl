// Stage 6: for and for-in loops.

// C-style for loop
var sum: i64  := 0;
for (var i := 0; i < 10; i += 1) {
    sum += i;
}

// for-in over an array
let arr: [i64] := [1, 2, 3];
var total: i64  := 0;
for (x in arr) {
    total += x;
}

// for-in over a range
var count: i64  := 0;
for (i in 0..5) {
    count += i;
}

// for-in over a range inclusive
var count2: i64  := 0;
for (i in 0..=4) {
    count2 += i;
}

// mutable for-in binding can be rebound locally
var bumped: i64 := 0;
for (var item in arr) {
    item += 1;
    bumped += item;
}

// nested for loops
var matrix_sum: i64  := 0;
for (var r := 0; r < 3; r += 1) {
    for (var c := 0; c < 3; c += 1) {
        matrix_sum += r + c;
    }
}

// for with no init or step
var x: i64  := 0;
for (; x < 5; ) {
    x += 1;
}
