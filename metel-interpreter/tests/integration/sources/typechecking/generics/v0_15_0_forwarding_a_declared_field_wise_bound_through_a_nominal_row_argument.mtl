// metel-core#1495: declaring the bound on the forwarding function makes the forward legal, for both
// shapes of row argument.
record Req<record R> { data: { ..R } }

fun id_of<record R>(r: Req<..R>) -> i64 where ..R: Copy { 1 }
fun forward<record R>(r: Req<..R>) -> i64 where ..R: Copy { id_of(r) }

fun id_ext<record R>(r: Req<..{ id: i64, ..R }>) -> i64 where ..R: Copy { 2 }
fun forward_ext<record R>(r: Req<..{ id: i64, ..R }>) -> i64 where ..R: Copy { id_ext(r) }

fun main() {
    let r := Req { data = { n = 1 } };
    assert(forward(r) == 1);
    let e := Req { data = { id = 1, n = 2 } };
    assert(forward_ext(e) == 2);
}
