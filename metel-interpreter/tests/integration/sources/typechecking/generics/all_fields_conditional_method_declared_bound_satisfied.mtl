// RFC-0173 D6: a generic body may select a record-target conditional method
// when its `all R: Mark` entitlement matches the impl's condition.

aspect Mark {}
aspect Label { fun label(&self) -> String; }

extend<row R> { ..R }: Label where all R: Mark {
    fun label(&self) -> String { "marked".to_string() }
}

fun use<row R>(value: { ..R }) -> String where all R: Mark {
    value.label()
}
