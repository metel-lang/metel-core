// Test that a negative bound (!Drop) correctly holds when the conditional impl's condition ISN'T met
aspect Drop { fun drop(self); }
struct Arena<T: !Drop> { items: [T] }
struct Pair<A, B> { first: A, second: B }
// Pair implements Drop only when BOTH A and B implement Drop
extend<A: Drop, B: Drop> Pair<A, B>: Drop { fun drop(self) {} }
struct Resource { x: i64 }
// Resource does NOT implement Drop, so the conditional impl doesn't apply

// This should work: Arena<Resource> is valid because Pair<Resource, Resource> doesn't
// implement Drop (its Drop impl requires both A and B to be Drop, but Resource doesn't implement Drop)
fun good(r: Resource) -> Arena<Pair<Resource, Resource>> {
    let x := r.x;
    Arena { items = [Pair { first = r, second = Resource { x = x } }] }
}

fun main() {}
