// Positive: generic enum with negative bound, constructed with a type that
// has no impl of the negated aspect.

aspect Drop {
    fun drop(self);
}

enum Opt<T: !Drop> {
    Some { value: T },
    None {},
}

struct Clean { x: i64 }

// Clean does NOT implement Drop.

fun make_some(c: Clean) -> Opt<Clean> {
    Opt::Some { value = c }
}
