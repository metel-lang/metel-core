// Negative: `extends Aspect[]` nested in a tuple still enforces the bound on the array's
// element type. Expect T0012.

aspect Printable {
    fun print(&self);
}

struct Plain { x: i64 }

// Plain does not implement Printable.

fun in_tuple(p: ([extends Printable], i64)) {
    for (item in p.0) {
        item.print()
    }
}

fun bad(xs: [Plain]) {
    in_tuple((xs, 1)) // ERROR[T0012]
}
