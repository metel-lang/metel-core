// RFC-0173 D1: a generic definition that keeps its parameters distinct and unbound is
// accepted, including recursion and a higher-order parameter.
fun first<T, U>(a: T, _b: U) -> T { a }

fun count_down<T>(x: T, n: i64) -> T {
    if (n == 0) { return x; }
    return count_down(x, n - 1);
}

fun twice<T>(x: T, f: |T| -> T) -> T {
    return f(f(x));
}

fun main() {
    assert(first(1, "x") == 1);
    assert(count_down(7, 3) == 7);
    assert(twice(2, |v: i64| -> i64 { v }) == 2);
}
