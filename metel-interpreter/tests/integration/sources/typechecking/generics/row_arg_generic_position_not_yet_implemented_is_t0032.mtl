// RFC-0121 item 2 (Open Rows, metel-core#1306 / metel-core#1310): generic-
// argument position (`Session<..R>`) is representation-only so far -- the
// row variable is validated (must exist as a declared generic in scope,
// same existence check an ordinary named type gets) but every real use of
// the resulting type is rejected, since row-polymorphic substitution
// through nominal-type instantiation isn't designed yet.

struct Session { token: i64 }

fun foo<row R>(s: Session<..R>) -> i64 { 0 }

fun main() {}
