aspect Bump {
    fun bump(&var self);
}

struct C {
    v: i64,
}

extend C: Bump {
    fun bump(&var self) {
        self.v = self.v + 1;
    }
}

// Resolving the method through `&T` must not also grant mutable access:
// a `&var self` method is not reachable through a shared reference.
fun mutate_through_shared<T: Bump>(x: &T) {
    x.bump();
}

fun main() {
    var c := C(v = 0);
    mutate_through_shared(&c);
}
