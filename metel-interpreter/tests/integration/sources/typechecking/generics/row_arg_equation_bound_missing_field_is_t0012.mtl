// RFC-0121 item 2 (metel-core#1310): `where R = { auth: String, .. }` is a
// real bound on the row-kinded parameter, checked at the call site.

record Builder<record R> { data: { ..R } }

fun auth_of<record R>(b: Builder<..R>) -> String where R = { auth: String, .. } {
    b.data.auth
}

fun main() {
    let b := Builder { data = { retries = 3 } };
    auth_of(b);
}
