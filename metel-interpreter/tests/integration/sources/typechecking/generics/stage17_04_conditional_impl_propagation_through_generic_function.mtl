// RFC-0036 §2.3: conditional impl bounds visible through a generic function.

aspect Printable {
    fun print(self) -> String;
}

extend i64: Printable {
    fun print(self) -> String { return "i64"; }
}

struct Pair<A, B> {
    first: A,
    second: B,
}

extend<A: Printable, B: Printable> Pair<A, B>: Printable {
    fun print(self) -> String {
        return "pair";
    }
}

fun print_pair<A: Printable, B: Printable>(p: Pair<A, B>) {
    let s: String := p.print();
}

fun main() {
    let p := Pair { first = 5, second = 10 };
    print_pair(p);
}
