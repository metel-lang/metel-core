// RFC-0036 §2.2: two-param conditional impl, both bounds satisfied.

aspect Printable {
    fun print(self) -> String;
}

extend i64: Printable {
    fun print(self) -> String { return "i64"; }
}

extend String: Printable {
    fun print(self) -> String { return "string"; }
}

struct Pair<A, B> {
    first: A,
    second: B,
}

extend<A, B> Pair<A, B>: Printable where A: Printable, B: Printable {
    fun print(self) -> String {
        return "pair";
    }
}

fun main() {
    let p := Pair { first = 5, second = "hello" };
    let s: String := p.print();
}
