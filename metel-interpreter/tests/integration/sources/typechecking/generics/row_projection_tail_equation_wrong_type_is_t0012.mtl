// RFC-0121 §2 (metel-core#1306 item 7): `extra` exists but at a different type than
// the equation names, so the equation's requirement is not met.

struct Handle { public fd: i64, public extra: String }

fun use_it<row R, row Rest>(h: Handle.{ fd, ..R }) -> i64
where R = { extra: i64, ..Rest } {
    h.fd
}

fun main() {
    let h := Handle { fd = 1, extra = "s" };
    println(use_it(h));
}
