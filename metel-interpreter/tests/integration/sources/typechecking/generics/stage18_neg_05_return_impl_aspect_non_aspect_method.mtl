// Negative: cannot call non-aspect method should fail with T0003
// Attempting to call method not declared by the aspect

aspect Display {
	fun display(&self) -> String;
}

struct MyInt {
	value: i64,
}

// Note: this struct has another method not in Display
extend MyInt {
	fun double(&self) -> i64 {
		self.value * 2
	}
}

extend MyInt: Display {
	fun display(&self) -> String {
		self.value.to_string()
	}
}

// Function returning extends Display
fun make_int() -> extends Display {
	MyInt { value = 42 }
}

fun main() {
	let int_val := make_int();
	// This should fail - cannot call non-aspect method on opaque value
	let doubled := int_val.double(); // ERROR[T0003]
}