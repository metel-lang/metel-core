// RFC-0173 D6: `each R: Tag` is an entitlement for the fields of R. Passing an
// open row to a callee that requires the entitlement must be rejected in this
// generic definition when it does not declare the same `all` bound.

aspect Tag {}

fun require_tagged<record R>(value: { ..R }) -> i64 where each R: Tag { 1 }

fun forward<record R>(value: { ..R }) -> i64 {
    require_tagged(value) // ERROR[T0012]
}
