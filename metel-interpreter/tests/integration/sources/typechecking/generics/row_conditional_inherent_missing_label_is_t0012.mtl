// RFC-0121 item 5 (metel-core#833): the impl's row bound requires `token`, so a
// receiver whose row has none cannot call its methods.

record Session<row R> { public id: i64, public data: { ..R } }

extend<row R: { token: String, .. }> Session<..R> {
    fun with_token(self) -> i64 { self.id }
}

fun main() {
    let s: Session<{ extra: i64 }> := Session { id = 1, data = { extra = 2 } };
    println(s.with_token());
}
