// Negative: cannot cast opaque return should fail with T0007
// Attempting to cast extends Display to unrelated type

aspect Display {
	fun display(&self) -> String;
}

struct MyInt {
	value: i64,
}

extend MyInt: Display {
	fun display(&self) -> String {
		self.value.to_string()
	}
}

// Function returning extends Display
fun make_int() -> extends Display {
	MyInt { value = 42 }
}

// A completely different type
struct MyString {
	value: String,
}

fun main() {
	let int_val := make_int();
	// This should fail - cannot cast extends Display to unrelated type
	let string_val: MyString := int_val as MyString; // ERROR[T0007]
}