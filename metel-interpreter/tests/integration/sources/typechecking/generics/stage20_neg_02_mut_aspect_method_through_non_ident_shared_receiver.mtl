aspect Bump {
    fun bump(&var self);
}

struct C {
    v: i64,
}

extend C: Bump {
    fun bump(&var self) {
        self.v = self.v + 1;
    }
}

// The receiver is `pair.0`, not an identifier. The guard cannot fall back to
// asking whether a *binding* is writable, because there is no binding — so the
// rule has to be about the reference chain itself.
fun sneak<T: Bump>(pair: (&T, i64)) {
    pair.0.bump();
}

fun main() {
    var c := C { v = 0 };
    sneak((&c, 1));
}
