// RFC-0121 §2 (metel-core#1310): the derived `Rest` is `{ extra: i64 }`, so an
// annotation naming any other remainder is a type mismatch.

record Session<record R> { id: i64, data: { ..R } }

fun authenticate<record R, record Rest>(s: Session<..R>) -> Session<..Rest>
where R = { token: String, ..Rest } {
    panic("unimplemented")
}

fun main() {
    let s: Session<{ token: String, extra: i64 }> :=
        Session { id = 1, data = { token = "t", extra = 2 } };
    let bad: Session<{ other: i64 }> := authenticate(s);
}
