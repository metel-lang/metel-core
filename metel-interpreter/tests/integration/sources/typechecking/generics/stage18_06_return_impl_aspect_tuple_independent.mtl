// Positive: tuple with independent extends Aspect positions
// RFC §1.3 example - both positions should work independently

aspect Display {
	fun display(&self) -> String;
}

struct MyInt {
	value: i64,
}

struct MyString {
	value: String,
}

extend MyInt: Display {
	fun display(&self) -> String {
		self.value.to_string()
	}
}

extend MyString: Display {
	fun display(&self) -> String {
		self.value.clone()
	}
}

// RFC §1.3 example - tuple with two independent extends Display positions
fun pair() -> (extends Display, extends Display) {
	(MyInt { value = 42 }, MyString { value = "hello".to_string() })
}

fun main() {
	let both := pair();

	// Both positions should work independently
	let int_display := both.0.display();
	let str_display := both.1.display();
}