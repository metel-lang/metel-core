// RFC-0121 §2 (metel-core#1310): the impl's equation `R = { token: String, ..Rest }`
// bounds `R`, so a receiver whose row has no `token` cannot call the method.

record Session<record R> { id: i64, data: { ..R } }

extend<record R, record Rest> Session<..R> where R = { token: String, ..Rest } {
    fun authenticate(self) -> Session<..Rest> { panic("unimplemented") }
}

fun main() {
    let s: Session<{ extra: i64 }> := Session { id = 1, data = { extra = 2 } };
    let r := s.authenticate();
}
