// #266: generic instance-method dispatch instantiates both the receiver's
// parameter and map's own U through the shared context helper.
struct Box1<T> { v: T }

extend<T> Box1<T> {
    fun map<U>(self, f: |T| -> U) -> Box1<U> { Box1 { v = f(self.v) } }
}

fun main() {
    let b := Box1 { v = 1 };
    let mapped := b.map(|x: i64| -> String { x.to_string() });
    let n: boolean := mapped; // ERROR[T0001]
}
