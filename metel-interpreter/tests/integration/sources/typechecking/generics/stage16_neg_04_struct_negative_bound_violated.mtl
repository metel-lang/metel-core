// Negative: generic struct with negative bound, constructed with a type that
// DOES implement the negated aspect. Expect T0012.

aspect Drop {
    fun drop(self);
}

struct Arena<T: !Drop> {
    items: [T],
}

struct Resource { x: i64 }

extend Resource: Drop {
    fun drop(self) {}
}

fun bad(r: Resource) -> Arena<Resource> {
    Arena { items = [r] } // ERROR[T0012]
}
