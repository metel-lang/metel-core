// Positive: ascribed `None` in a generic function body constrains the inferred return type.

fun maybe_head<T: Copy>(items: [T]) -> Option<T> {
    if (items.len() == 0) {
        return None : Option<T>;
    }
    return Option::Some { value = items[0] };
}

fun main() {
    let a: Option<i64> := maybe_head([1, 2, 3]);
    let b: Option<i64> := maybe_head([] : [i64]);
}
