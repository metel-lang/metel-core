// RFC-0173 D1: a generic method carries row-equation remainder facts into
// its body as well.
record Session<row R> { public data: { ..R } }
struct Host {}

extend Host {
    fun read_removed<row R, row Rest>(value: Session<..Rest>) -> String
    where R = { token: String, ..Rest } {
        value.data.token // ERROR[T0003]
    }
}

fun main() {
    Host {}.read_removed(Session { data = { extra = 1 } });
}
