// RFC-0121 (Open Rows, metel-core#1301) sec2: `Handle.{ fd, ..R }` requires
// the argument's own brand to match exactly -- `Other` is a different struct,
// even though it happens to declare a field with the same name.

struct Handle { fd: i64 }
struct Other { fd: i64 }

fun get_fd<row R>(h: Handle.{ fd, ..R }) -> i64 { h.fd }

fun main() {
    let o := Other { fd = 1 };
    let _ := get_fd(o);
}
