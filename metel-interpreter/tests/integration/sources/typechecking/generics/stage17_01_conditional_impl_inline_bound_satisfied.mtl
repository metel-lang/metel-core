// RFC-0036 §2.2: conditional impl with inline bound, called with a satisfying
// concrete type.

aspect Printable {
    fun print(self) -> String;
}

extend i64: Printable {
    fun print(self) -> String { return "i64"; }
}

struct Pair<A, B> {
    first: A,
    second: B,
}

extend<A: Printable, B: Printable> Pair<A, B>: Printable {
    fun print(self) -> String {
        return "pair";
    }
}

fun main() {
    let p := Pair { first = 5, second = 10 };
    let s: String := p.print();
}
