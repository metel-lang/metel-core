// RFC-0121 item 2 (metel-core#1310): an anonymous row argument is a free function's
// parameter type only; a method's parameter must name its row.
record Session<row R> { public id: i64, public data: { ..R } }
struct Tool { public n: i64 }

extend Tool {
    fun take(&self, s: Session<..>) -> i64 { s.id + self.n }
}

fun main() {
}
