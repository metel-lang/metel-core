// `<record T>` with no row bound at all accepts a record of any shape --
// the `record` marker alone establishes the parameter's kind.
fun keep<record T>(value: T) -> T { value }

fun main() {
    let a := keep({ .x = 1 });
    assert(a.x == 1);

    let b := keep({ .x = 1, .y = "two", .z = true });
    assert(b.x == 1);
    assert(b.y == "two");
    assert(b.z);
}
