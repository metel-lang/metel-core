// Cross-module test: module2 provides its own public fun returning extends Aspect

aspect Display {
	fun display(&self) -> String;
}

struct MyString {
	value: String,
}

extend MyString: Display {
	fun display(&self) -> String {
		self.value.clone()
	}
}

pub fun make_string() -> extends Display {
	MyString(value = "hello".to_string())
}