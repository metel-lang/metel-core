// Cross-module test: module1 with public function returning extends Aspect

aspect Display {
	fun display(&self) -> String;
}

struct MyInt {
	value: i64,
}

extend MyInt: Display {
	fun display(&self) -> String {
		self.value.to_string()
	}
}

pub fun make_public_int() -> extends Display {
	MyInt { value = 42 }
}