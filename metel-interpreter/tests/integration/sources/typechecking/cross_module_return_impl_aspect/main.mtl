// Cross-module test: main module importing both modules

import module1::make_public_int;
import module2::make_string;

aspect Display {
	fun display(&self) -> String;
}

struct MyFloat {
	value: f64,
}

extend MyFloat: Display {
	fun display(&self) -> String {
		self.value.to_string()
	}
}

pub fun make_float() -> extends Display {
	MyFloat(value = 3.14)
}

fun main() {
	// Call functions from different modules
	let int_val := make_public_int();
	let string_val := make_string();
	let float_val := make_float();
	
	// Call aspect methods - this exercises the cross-module boundary
	let int_str := int_val.display();
	let str_str := string_val.display();
	let float_str := float_val.display();
}