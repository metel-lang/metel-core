// metel-core#280: every form the addressability rule admits keeps working, including
// RFC-0110 §6's reborrow `&*p`, which previously hit the same internal error despite the
// RFC specifying it as legal.
struct Point { x: i64, y: i64 }
struct Pair { a: Point }

fun main() {
    let n := 1;
    let arr := [1, 2, 3];
    let t := (10, 20);
    let pair := Pair { a = Point { x = 1, y = 2 } };

    let p1 := &n;              // binding
    let p2 := &pair.a;         // field
    let p3 := &pair.a.x;       // chained field
    let p4 := &t.0;            // tuple element
    let p5 := &arr[1];         // array element
    assert(*p1 == 1);
    assert(*p3 == 1);
    assert(*p4 == 10);
    assert(*p5 == 2);
    assert(p2.y == 2);

    // Reborrow: `&*p` shares the referent's storage rather than snapshotting it.
    var m := 5;
    let mp: &var i64 := &var m;
    let rb := &*mp;
    assert(*rb == 5);

    let rbm := &var *mp;
    *rbm = 9;
    assert(m == 9);
}
