// metel-core#1984: and for a type declared in a block (#1979 records its impl with the argument).
aspect Conv<T> { fun conv(&self) -> T; }
fun use_conv<X: Conv<i64>>(x: &X) -> i64 { x.conv() }
fun main() {
    struct L { n: i64 }
    extend L: Conv<String> { fun conv(&self) -> String { "x" } }
    use_conv(&L { n = 4 });
}
