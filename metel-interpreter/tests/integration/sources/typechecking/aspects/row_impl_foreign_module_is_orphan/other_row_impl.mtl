import describe_aspect::Describe;

// An anonymous record shape has no owning module, so this module owns neither half
// of the pair: a second module cannot add a competing row impl.
extend<record R: { h: i64, .. }> { ..R }: Describe { // ERROR[T0014]
    fun describe(&self) -> String { "h".to_string() }
}

public fun touch() {}
