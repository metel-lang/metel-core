// RFC-0060 §1 / RFC-0121 §3: two modules cannot offer conflicting implementations of an
// aspect for the same record shape. The foreign module's row impl is an orphan
// (T0014) -- reported there, before any overlap (T0015) or method-ambiguity (T0013)
// question can arise between it and `describe_aspect`'s own impl.

import describe_aspect::Describe;
import other_row_impl::touch;

fun main() {
    touch();
    let r := { w = 1, h = 2 };
    println(r.describe());
}
