// metel-core#1984: a bound that names an aspect type argument is satisfied only by an impl with that argument.
aspect Conv<T> { fun conv(&self) -> T; }
fun use_conv<X: Conv<i64>>(x: &X) -> i64 { x.conv() }
struct L { n: i64 }
extend L: Conv<String> { fun conv(&self) -> String { "x" } }
fun main() { use_conv(&L { n = 4 }); }
