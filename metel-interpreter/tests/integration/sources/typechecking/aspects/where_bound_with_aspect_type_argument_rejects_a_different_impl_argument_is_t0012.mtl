// metel-core#1984: the same for a bound written in a `where` clause; the message names what the type implements.
aspect Conv<T> { fun conv(&self) -> T; }
fun use_conv<X>(x: &X) -> i64 where X: Conv<i64> { x.conv() }
struct L { n: i64 }
extend L: Conv<String> { fun conv(&self) -> String { "x" } }
fun main() { use_conv(&L { n = 4 }); }
