// RFC-0060 coherence, generalized to structural targets (issue #272): two
// different aspects providing the same method name for `T[]` is ambiguous
// dispatch when their bounds could both apply to the same element type (here,
// `Display` and `Clone` are unrelated -- nothing stops a type from satisfying
// both), the same way it's already rejected for two aspects on the same
// concrete, non-generic type. Coherence must catch this before construction
// ever tries to pick one, not silently prefer whichever was registered last.

aspect Foo {
    fun describe(&self) -> String;
}

aspect Bar {
    fun describe(&self) -> String;
}

extend<T: Display> [T]: Foo {
    fun describe(&self) -> String {
        return "foo-array";
    }
}

extend<T: Clone> [T]: Bar { // ERROR[T0013]
    fun describe(&self) -> String {
        return "bar-array";
    }
}

fun main() {
    let a: [i64] := [1, 2, 3];
    println(a.describe());
}
