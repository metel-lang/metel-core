// Negative: associated type's concrete binding does not satisfy its declared bound.
// Expect T0012.

aspect Container {
    type Item: Display;
    fun get(&self) -> Item;
}

struct Plain {
    x: i64,
}

struct IntBox {
    value: i64,
}

extend IntBox: Container { // ERROR[T0012]
    type Item := Plain;
    fun get(&self) -> Plain {
        return Plain { x = self.value };
    }
}

fun main() {
    let b := IntBox { value = 42 };
    assert(1 == 1);
}
