// Regression guard: a negative impl for one concrete instantiation must not
// affect an unrelated instantiation of the same generic struct -- Foo<boolean>
// has no negative impl of its own, so the blanket impl still applies.

aspect Marker {
    fun mark(self) -> String;
}

struct Foo<T> {
    value: T,
}

extend<T> Foo<T>: Marker {
    fun mark(self) -> String { return "blanket"; }
}

extend Foo<i64>: !Marker;

fun needs_marker<U: Marker>(x: U) {}

fun main() {
    let f := Foo { value = true };
    needs_marker(f);
}
