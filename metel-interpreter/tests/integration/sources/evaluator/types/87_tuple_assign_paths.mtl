struct Holder { t: (i64, (i64, i64)) }

fun main() {
    var t := (1, 2);
    t.0 = 5;
    assert(t.0 == 5);
    t.0 += 4;
    assert(t.0 == 9);

    var nested := (10, (20, 30));
    nested.1.0 = 99;
    assert(nested.1.0 == 99);

    var s := Holder { t = (7, (8, 9)) };
    s.t.0 = 11;
    assert(s.t.0 == 11);

    tuple_assign_through_references();
}

// Tuple-element assignment must reach through a reference at any step of the path, the
// way field- and index-path assignment already do. Neither pass peeled for tuple targets
// when the variant was first added, so `t.0 = v` worked on a plain binding but not on a
// `&var` receiver -- a seam between metel-core#283 and the RFC-0110 reference work.
struct RefHolder { pair: (i64, i64) }

fun set_direct(t: &var (i64, i64)) {
    t.0 = 9;
    t.1 += 5;
}

fun set_nested(h: &var RefHolder) {
    h.pair.0 = 42;
    h.pair.1 += 3;
}

fun tuple_assign_through_references() {
    var t := (1, 2);
    set_direct(&var t);
    assert(t.0 == 9);
    assert(t.1 == 7);

    var rh := RefHolder { pair = (1, 2) };
    set_nested(&var rh);
    assert(rh.pair.0 == 42);
    assert(rh.pair.1 == 5);

    // A shared reference still grants no write access.
    let r: &i64 := &rh.pair.0;
    rh.pair.0 = 7;
    assert(*r == 7);   // and it aliases (metel-core#282)
}
