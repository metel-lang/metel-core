// RFC-0110 §4.2/§5: write-through is spelled explicitly, one `*` per reference layer.
// This replaces RFC-0067a's implicit rule, under which a bare `pp = 5` peeled *every*
// `&var` layer at once — convenient, but it made the number of layers invisible at the
// write site and left no way to repoint any of them.
fun main() {
    var n := 1;
    var p: &var i64 := &var n;
    let pp: &var &var i64 := &var p;

    **pp = 5;      // two layers, two stars
    assert(n == 5);

    **pp += 10;
    assert(n == 15);

    // One star reaches the inner reference itself, not the i64 — which is what makes
    // repointing through a chain expressible at all.
    var m := 100;
    *pp = &var m;  // p now refers to m; n keeps its value
    assert(n == 15);
    **pp = 7;
    assert(m == 7);
}
