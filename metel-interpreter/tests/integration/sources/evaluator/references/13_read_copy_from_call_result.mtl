// RFC-0185: a call returning `&T` is read out with `*` exactly like a reference
// binding -- same position, same types, same spelling (formerly RFC-0112 §1.0).

fun shared() -> &i64 {
    let a := 42;
    return &a;
}

fun chained() -> &&i64 {
    let a := 42;
    let r: &i64 := &a;
    return &r;
}

fun through_return() -> i64 {
    return *shared();
}

fun main() {
    // let annotation
    let n: i64 := *shared();
    assert(n == 42);

    // binding the call result first, then copying out at the annotation
    let r := shared();
    let m: i64 := *r;
    assert(m == 42);

    // ascription
    let a := (*shared()): i64;
    assert(a == 42);

    // return position
    assert(through_return() == 42);

    // every layer is peeled, not just one
    let c: i64 := **chained();
    assert(c == 42);

    // the reference itself is still available when that is what is asked for
    let keep := shared();
    assert(*keep == 42);
}
