// RFC-0185: an explicit read `*a` at an implicit tail expression (no `return`
// keyword), through an `if`/`else` whose branches read out of references.
fun pick(cond: boolean, a: &i64, b: &i64) -> i64 {
    if (cond) { *a } else { *b }
}

fun main() {
    let x := 10;
    let y := 20;
    assert(pick(true, &x, &y) == 10);
    assert(pick(false, &x, &y) == 20);
}
