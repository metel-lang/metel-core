// TYPECHECK_ERROR[T0001]
// RFC-0185 (formerly #649): an implicit tail expression is not read out of a reference;
// mirrors `02_read_copy_at_tail_expression.mtl`, which spells `*a`.
struct NotCopy { v: String }

fun pick(cond: boolean, a: &NotCopy, b: &NotCopy) -> NotCopy {
    if (cond) { a } else { b }
}

fun main() {
    let x := NotCopy { v = "x" };
    let y := NotCopy { v = "y" };
    let _ := pick(true, &x, &y);
}
