// TYPECHECK_ERROR[T0001]
// RFC-0185 (formerly #649): no implicit read through any number of reference layers --
// mirrors `07_read_copy_through_reference_chain.mtl`, which spells `**rr`.
struct NotCopy { v: String }

fun main() {
    let owned := NotCopy { v = "x" };
    let r: &NotCopy := &owned;
    let rr: &&NotCopy := &r;
    let copy: NotCopy := rr;
}
