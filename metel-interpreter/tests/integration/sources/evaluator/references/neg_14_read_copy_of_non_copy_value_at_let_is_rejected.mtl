// TYPECHECK_ERROR[T0001]
// RFC-0185 (formerly #649): a reference is never implicitly read out as its referent,
// whether or not the referent is `Copy` -- a `let` annotation does not dereference.
struct NotCopy { v: String }

fun main() {
    let owned := NotCopy { v = "x" };
    let r: &NotCopy := &owned;
    let copy: NotCopy := r;
}
