// TYPECHECK_ERROR[T0001]
// RFC-0185 (formerly #649): a reference cannot be returned as its referent type;
// mirrors `01_read_copy_at_return.mtl`, which spells `*p`.
struct NotCopy { v: String }

fun f(r: &NotCopy) -> NotCopy {
    return r;
}

fun main() {
    let owned := NotCopy { v = "x" };
    let _ := f(&owned);
}
