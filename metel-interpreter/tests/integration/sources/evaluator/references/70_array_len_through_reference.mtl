fun via_param(arr: &[i64]) -> i64 {
    arr.len()
}

fun via_sized(arr: &[i64; 3]) -> i64 {
    arr.len()
}

fun main() {
    let data: [i64] := [1, 2, 3];
    assert(via_param(&data) == 3);
    let fixed: [i64; 3] := [4, 5, 6];
    assert(via_sized(&fixed) == 3);
    // Inline reference to a by-value parameter, and a double reference.
    let r := &data;
    assert((&data).len() == 3);
    assert(r.len() == 3);
}
