// RFC-0067a §3: auto-deref for field access/method dispatch already chains through
// arbitrary depth ("&&T derefs through both levels") independent of read-copy —
// confirms this pre-existing guarantee explicitly under the new &T/&var T syntax.
struct Counter { value: i64 }

extend Counter {
    fun get(&self) -> i64 {
        self.value
    }
    fun bump(&var self) {
        self.value += 1;
    }
}

fun main() {
    var c := Counter { value = 1 };
    let r: &var Counter := &var c;
    let rr: &&var Counter := &r;

    assert(rr.value == 1);
    assert(rr.get() == 1);

    rr.bump();
    assert(c.value == 2);
}
