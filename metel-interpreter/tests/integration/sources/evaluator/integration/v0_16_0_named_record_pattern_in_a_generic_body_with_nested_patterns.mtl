// v0.16.0 integration: a named record pattern in a generic body x nested struct, copy(T) and tuple patterns x match
// exhaustiveness x derived Clone x a closure x a copy function field.
copy struct Tag { n: i64 }
struct Boxed<T> derives Clone(T), Copy(T) { value: T }
copy record Holder { tag: Tag, boxed: Boxed<i64>, pair: (i64, i64), f: copy |i64| -> i64 }

fun total<T>(h: Holder, unused: T) -> i64 {
    let .{ .tag: Tag { n }, .boxed: Boxed { value }, .pair: (a, b), .f } := h;
    f(n + value + a + b)
}

fun tag_of<T>(h: Holder, unused: T) -> i64 {
    match (h) {
        .{ .tag: Tag { n }, .. } => n,
    }
}

fun cloned<T>(h: Holder, unused: T) -> i64 {
    let c := h.clone();
    let g := || { c.tag.n + h.pair.0 };
    g()
}

fun main() {
    let inc: copy |i64| -> i64 := |x| { x + 1 };
    let h := Holder { tag = Tag { n = 1 }, boxed = Boxed { value = 2 }, pair = (3, 4), f = inc };
    assert(total(h, 0) == 11);
    assert(tag_of(h, 0) == 1);
    assert(cloned(h, 0) == 4);
}
