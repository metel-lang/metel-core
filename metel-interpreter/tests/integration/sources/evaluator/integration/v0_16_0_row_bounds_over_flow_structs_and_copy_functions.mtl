// v0.16.0 integration: negative row-bound entries x derivation arguments x the copy function-type qualifier.
copy struct Id { n: i64 }
struct Wrapper<T> derives Clone(T), Copy(T) { value: T }
fun describe<record R: .{ .id: Id, .name: String, !.secret, .. }>(r: R) -> i64 { r.id.n }
fun bump<record R: .{ .f: copy |i64| -> i64, !.secret, .. }>(r: R, x: i64) -> i64 { (r.f)(x) }
fun main() {
    let w := Wrapper(value = 3);
    let w2 := w;
    let w3 := w;
    assert(w2.value + w3.value == 6);
    let r := .{ .id = Id(n = 7), .name = "n" };
    assert(describe(r) == 7);
    let inc: copy |i64| -> i64 := |x| { x + 1 };
    let s := .{ .f = inc, .k = 1 };
    assert(bump(s, 1) == 2);
}
