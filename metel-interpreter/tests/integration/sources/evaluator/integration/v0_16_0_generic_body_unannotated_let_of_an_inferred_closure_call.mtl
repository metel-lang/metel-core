// metel-core#2085: in a generic body, the result of calling an inferred closure, bound by an unannotated `let`, has the
// closure's return type (reconstruction carries no Pass 1 closure facts, so it reads the type off the closure body).
fun literal<T>(unused: T) -> i64 {
    let g := || { 3 };
    let r := g();
    r + 1
}
fun with_param<T>(unused: T) -> i64 {
    let g := |x: i64| { x };
    let r := g(3);
    r + 1
}
fun through_copy_function<T>(unused: T, f: copy |i64| -> i64) -> i64 {
    let g := || { f(3) };
    let r := g();
    r + 1
}
fun text<T>(unused: T) -> String {
    let g := || { "s" };
    let r := g();
    r + "t"
}
fun nested<T>(unused: T) -> i64 {
    let outer := || { let inner := || { 2 }; inner() + 1 };
    let r := outer();
    r + 1
}
fun main() {
    let inc: copy |i64| -> i64 := |x| { x + 1 };
    assert(literal(0) == 4);
    assert(with_param(0) == 4);
    assert(through_copy_function(0, inc) == 5);
    assert(text(0) == "st");
    assert(nested(0) == 4);
}
