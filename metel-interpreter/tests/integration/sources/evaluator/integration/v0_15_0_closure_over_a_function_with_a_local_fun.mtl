// RFC-0195 x RFC-0196 x closure capture lists: a local fun called outside a var closure that
// captures a parameter by &var, in a function with a written signature (RFC-0193).
fun total(base: i64, step: i64) -> i64 {
    fun twice(v: i64) -> i64 { return v * 2; }
    var acc := base;
    let bump := [&var acc] var |k: i64| { acc += k; };
    bump(twice(step));
    bump(twice(step));
    return acc;
}
fun main() {
    assert(total(1, 3) == 13);
}
