// v0.16.0 integration: copy(T) structs x a closure in a generic body x a residual of a record.
copy(T) struct Boxed<T> { value: T }
fun twice<T: Copy>(b: Boxed<T>) -> (Boxed<T>, Boxed<T>) {
    let g := || { b };
    let first := b;
    let second := b;
    (first, second)
}
fun main() {
    let (x, y) := twice(Boxed { value = 4i64 });
    assert(x.value + y.value == 8);
    let r := .{ .b = Boxed { value = 1i64 }, .s = "s" };
    let s := r.s;
    let a := r.b;
    let c := r.b;
    assert(a.value + c.value == 2);
    assert(s == "s");
}
