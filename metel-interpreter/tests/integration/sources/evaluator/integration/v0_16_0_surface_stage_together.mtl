// The v0.16.0 surface stage (metel-core#1868): `pub`, `=` as a statement, nominal brace construction (RFC-0100 rolled back by #1945), keyword
// arguments at every call, dotted row labels, negative row-bound entries and replacement in a record spread,
// in one program, so a contradiction between any two of them is a failure here.
pub struct Reading { pub sensor: i64, value: i64 }

extend Reading {
    pub fun new(sensor: i64, value: i64) -> Reading { Reading { sensor, value } }
    pub fun scaled(&self, by: i64, offset: i64) -> i64 { self.value * by + offset }
}

pub struct Counter { n: i64 }

extend Counter {
    fun next(&var self) -> i64 {
        self.n = self.n + 1;
        self.n
    }
}

pub enum Event { Sample { id: i64, level: i64 }, Idle }

record Frame<record R> { seq: i64, data: { ..R } }

extend<record R: { .tag: i64, !.drop, .. }> Frame<..R> {
    fun kind(&self) -> i64 { 1 }
}

extend<record R: { !.tag, .. }> Frame<..R> {
    fun kind(&self) -> i64 { 2 }
}

fun clamp<record R: { .level: i64, !.secret, .. }>(r: R) -> i64 { r.level }

fun describe(e: Event) -> i64 {
    match (e) {
        Event::Sample { id, level } => id * 100 + level,
        Event::Idle => 0,
    }
}

fun main() {
    // ordinary factory calls, positional and keyword, in either order
    let a := Reading::new(sensor = 1, value = 5);
    let b := Reading::new(value = 6, sensor = 2);
    assert(a.sensor + b.sensor == 3);

    // keyword arguments on a method call, in a different order than declared
    assert(a.scaled(offset = 3, by = 2) == 13);

    // `=` is a statement; compound operators and for-update clauses
    var total := 0;
    for (var i := 0; i < 3; i += 1) { total = total + i; }
    assert(total == 3);

    // dotted labels: a record literal, a pattern, a type
    let sample := { .id = 7, .level = 4 };
    let { .id, .level } := sample;
    assert(id == 7 && level == 4);

    // enum struct-variant built and destructured with nominal braces
    assert(describe(Event::Sample { level = 4, id = 7 }) == 704);
    assert(describe(Event::Idle) == 0);

    // a record spread replacing a present field and adding an absent one
    let bumped := { ..sample, .level = sample.level + 1, .note = 1 };
    assert(bumped.level == 5 && bumped.id == 7 && bumped.note == 1);

    // a negative row-bound entry selects the impl; a bound with a negative entry accepts the record
    let tagged := Frame { seq = 1, data = { .tag = 9 } };
    let plain := Frame { seq = 2, data = { .count = 3 } };
    assert(tagged.kind() == 1 && plain.kind() == 2);
    assert(clamp({ .level = 8, .extra = 1 }) == 8);

    // a construction call whose arguments carry side effects evaluates them as written
    var counter := Counter { n = 0 };
    let first := Reading { value = counter.next(), sensor = counter.next() * 10 };
    assert(first.value == 1 && first.sensor == 20);
}
