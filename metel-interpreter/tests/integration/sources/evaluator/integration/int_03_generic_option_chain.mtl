// Integration Test 3 — Generic Option Chaining
//
// Feature coverage (v0.3):
//   user-defined generic enum (Option<T>), generic struct (Pair<A,B>),
//   generic functions with multiple type parameters, let-polymorphism,
//   braceless if
// Feature coverage (v0.1/v0.2):
//   match-with-blocks, closures, higher-order functions, arrays,
//   Perhaps<T>, string operations, Result<T,E>, ? operator

// ── User-defined Option<T> ────────────────────────────────────────────────────

enum Option<T> {
    Some { value: T },
    None {},
}

// ── Generic Option combinators ────────────────────────────────────────────────

fun option_map<T, U>(opt: Option<T>, f: |T| -> U) -> Option<U> {
    match (opt) {
        Option::Some { value } => Option::Some { value = f(value) },
        _                      => Option::None,
    }
}

fun option_map_2<T, U>(opt: Option<T>, f: |T| -> U) -> Option<U> {
    match (opt) {
        Option::Some { value } => Option::Some { value = f(value) },
        _                      => Option::None,
    }
}

fun option_and_then<T, U>(opt: Option<T>, f: |T| -> Option<U>) -> Option<U> {
    match (opt) {
        Option::Some { value } => f(value),
        _                      => Option::None,
    }
}

fun option_or<T>(opt: Option<T>, fallback: T) -> T {
    match (opt) {
        Option::Some { value } => value,
        _                      => fallback,
    }
}

fun option_filter<T>(opt: Option<T>, pred: |&T| -> boolean) -> Option<T> {
    match (opt) {
        Option::Some { value } => if (pred(&value)) Option::Some { value = value } else Option::None,
        _                      => Option::None,
    }
}

fun option_is_some<T>(opt: Option<T>) -> boolean {
    match (opt) {
        Option::Some { value } => true,
        _                      => false,
    }
}

// ── Generic Pair<A,B> ─────────────────────────────────────────────────────────

struct Pair<A, B> {
    first: A,
    second: B,
}

fun pair_map_first<A, B, C>(p: Pair<A, B>, f: |A| -> C) -> Pair<C, B> {
    Pair { first = f(p.first), second = p.second }
}

fun pair_map_second<A, B, C>(p: Pair<A, B>, f: |B| -> C) -> Pair<A, C> {
    Pair { first = p.first, second = f(p.second) }
}

fun pair_swap<A, B>(p: Pair<A, B>) -> Pair<B, A> {
    Pair { first = p.second, second = p.first }
}

// ── Generic array utilities ───────────────────────────────────────────────────

// Ownership workaround (#328): `[T]` is a borrowed view, so a non-`Copy` element cannot be
// moved out of it -- #329 enforces that. Indexing plus an explicit clone callback makes the
// result owned. The callback is scaffolding, not part of what this fixture tests; it goes
// away once `Clone` has stdlib coverage, or sooner via a `T: Copy` bound where the
// elements are `Copy` (#335, #328).
fun find_first<T>(arr: [T], pred: |&T| -> boolean, clone: |&T| -> T) -> Option<T> {
    var i := 0;
    while (i < arr.len()) {
        if (pred(&arr[i as u64])) {
            return Option::Some { value = clone(&arr[i as u64]) };
        }
        i += 1;
    }
    Option::None
}

fun count_where<T>(arr: [T], pred: |&T| -> boolean) -> i64 {
    var cnt := 0;
    for (x in arr) {
        if (pred(&x)) { cnt += 1; }
    }
    cnt
}

fun map_array<T, U>(arr: [T], f: |&T| -> U) -> [U] {
    var out: List<U> := List::new();
    for (x in arr) { out.push(f(&x)); }
    out.as_slice()
}

// ── Safe integer division returning Option<i64> ───────────────────────────────

fun safe_div(a: i64, b: i64) -> Option<i64> {
    if (b == 0) Option::None else Option::Some { value = a / b }
}

fun safe_div_2(a: i64, b: i64) -> Option<i64> {
    if (b == 0) Option::None else Option::Some { value = a / b }
}

// ── Safe array index ──────────────────────────────────────────────────────────

fun safe_get_int(arr: [i64], i: i64) -> Option<i64> {
    if (i < 0 || i >= arr.len()) Option::None
    else Option::Some { value = arr[i as u64] }
}

// ── String lookup in a [Pair<String,i64>] "map" ───────────────────────────────

fun table_get(table: [Pair<String, i64>], key: String) -> Option<i64> {
    let entry := find_first(
        table,
        [key.clone()] |p: &Pair<String, i64>| -> boolean { (*p).first == key },
        |p: &Pair<String, i64>| -> Pair<String, i64> {
            Pair {
                first = (*p).first.substring(0, (*p).first.len()),
                second = (*p).second,
            }
        },
    );
    option_map(entry, |p: Pair<String, i64>| -> i64 { p.second })
}

// ── Entry point ───────────────────────────────────────────────────────────────

fun main() {
    // ── Let-polymorphism: id used at i64, boolean, String ─────────────────────────
    let id := |x| { x };
    assert(id(42) == 42);
    assert(id(true));
    assert(id("hello") == "hello");

    // ── Option<i64> basic combinators ─────────────────────────────────────────
    let some10: Option<i64>  := Option::Some { value = 10 };
    let none_i: Option<i64>  := Option::None;

    // map: Some(10) → Some(20)
    let doubled := option_map(Option::Some { value = 10 }, |x: i64| -> i64 { x * 2 });
    assert(option_or(doubled, 0) == 20);

    // map over None → None
    let none_i_map: Option<i64> := Option::None;
    let mapped_none := option_map(none_i_map, |x: i64| -> i64 { x * 2 });
    assert(!option_is_some(mapped_none));

    // or: Some(10) → 10, None → 99
    assert(option_or(some10,  0)  == 10);
    assert(option_or(none_i,  99) == 99);

    // filter: keeps if predicate holds
    let keep   := option_filter(Option::Some { value = 10 }, |x: &i64| -> boolean { *x > 5  });
    let remove := option_filter(Option::Some { value = 10 }, |x: &i64| -> boolean { *x > 50 });
    assert(option_is_some(keep));
    assert(!option_is_some(remove));

    // and_then (flatMap): chain two operations
    let chained := option_and_then(Option::Some { value = 10 }, |x: i64| -> Option<i64> {
        if (x > 5) Option::Some { value = x + 1 } else Option::None
    });
    assert(option_or(chained, 0) == 11);

    let none_i_chain: Option<i64> := Option::None;
    let chained_none := option_and_then(none_i_chain, |x: i64| -> Option<i64> {
        Option::Some { value = x + 1 }
    });
    assert(!option_is_some(chained_none));

    // ── Option<boolean> ──────────────────────────────────────────────────────────
    let some_true: Option<boolean> := Option::Some { value = true };
    let some_false: Option<boolean> := Option::Some { value = false };

    assert(option_or(some_true,  false));
    assert(!option_or(some_false, true));

    let negated := option_map(Option::Some { value = true }, |b: boolean| -> boolean { !b });
    assert(!option_or(negated, true));

    // ── Option<String> ────────────────────────────────────────────────────────
    let some_str: Option<String> := Option::Some { value = "hello" };
    let none_str: Option<String> := Option::None;

    let upper_len := option_map(some_str, |s: String| -> i64 { s.len() });
    assert(option_or(upper_len, 0) == 5);
    assert(option_or(none_str, "default") == "default");

    // ── safe_div: chained divisions ───────────────────────────────────────────
    let r1 := safe_div(100, 5);    // Some(20)
    let r2 := safe_div(100, 0);    // None
    assert(option_or(r1, -1) == 20);
    assert(!option_is_some(r2));

    // Chain: 100 / 5 / 4 = 5
    let chain_div := option_and_then(safe_div(100, 5), |x: i64| -> Option<i64> {
        safe_div(x, 4)
    });
    assert(option_or(chain_div, -1) == 5);

    // Chain where second step divides by zero → None
    let chain_zero := option_and_then(safe_div_2(100, 5), |x: i64| -> Option<i64> {
        safe_div_2(x, 0)
    });
    assert(!option_is_some(chain_zero));

    // ── safe_get_int ──────────────────────────────────────────────────────────
    let arr: [i64] := [10, 20, 30, 40, 50];
    assert(option_or(safe_get_int(arr, 0),  -1) == 10);
    let arr_4: [i64] := [10, 20, 30, 40, 50];
    assert(option_or(safe_get_int(arr_4, 4),  -1) == 50);
    let arr_5: [i64] := [10, 20, 30, 40, 50];
    assert(!option_is_some(safe_get_int(arr_5, 5)));
    let arr_neg1: [i64] := [10, 20, 30, 40, 50];
    assert(!option_is_some(safe_get_int(arr_neg1, -1)));

    // Chain: get element then double it
    let arr_2: [i64] := [10, 20, 30, 40, 50];
    let doubled_elem := option_map(safe_get_int(arr_2, 2), |x: i64| -> i64 { x * 2 });
    assert(option_or(doubled_elem, -1) == 60);

    // ── Pair<A,B> operations ──────────────────────────────────────────────────
    let p1: Pair<i64, boolean> := Pair { first = 7, second = true };
    assert(p1.first == 7);
    assert(p1.second);

    // map_first: double the i64
    let p2 := pair_map_first(Pair { first = 7, second = true }, |x: i64| -> i64 { x * 2 });
    assert(p2.first == 14);
    assert(p2.second);

    // map_second: negate the boolean
    let p3 := pair_map_second(Pair { first = 7, second = true }, |b: boolean| -> boolean { !b });
    assert(p3.first  == 7);
    assert(!p3.second);

    // swap: Pair<i64,boolean> → Pair<boolean,i64>
    let p4 := pair_swap(Pair { first = 7, second = true });
    assert(p4.first);
    assert(p4.second == 7);

    // Pair<String, i64> for a name–score record
    let score := Pair { first = "Alice", second = 95 };
    assert(score.first == "Alice");
    assert(score.second == 95);
    let bumped := pair_map_second(score, |n: i64| -> i64 { n + 5 });
    assert(bumped.second == 100);

    // ── table_get: [Pair<String,i64>] as a lookup table ───────────────────────
    let table: [Pair<String, i64>] := [
        Pair { first = "apples",  second = 3  },
        Pair { first = "bananas", second = 7  },
        Pair { first = "cherries", second = 12 },
    ];

    let apples  := table_get(table, "apples");
    let table_again: [Pair<String, i64>] := [
        Pair { first = "apples",  second = 3  },
        Pair { first = "bananas", second = 7  },
        Pair { first = "cherries", second = 12 },
    ];
    let missing := table_get(table_again, "grapes");
    assert(option_or(apples,  0) == 3);
    assert(!option_is_some(missing));

    // Compute total of found items using and_then
    let table_apples_again: [Pair<String, i64>] := [
        Pair { first = "apples",  second = 3  },
        Pair { first = "bananas", second = 7  },
        Pair { first = "cherries", second = 12 },
    ];
    let apples_for_total := table_get(table_apples_again, "apples");
    let table_third: [Pair<String, i64>] := [
        Pair { first = "apples",  second = 3  },
        Pair { first = "bananas", second = 7  },
        Pair { first = "cherries", second = 12 },
    ];
    let bananas := table_get(table_third, "bananas");
    let total := option_and_then(apples_for_total, [bananas] once |a: i64| -> Option<i64> {
        option_map_2(bananas, |b: i64| -> i64 { a + b })
    });
    assert(option_or(total, 0) == 10);

    // ── find_first and count_where on [i64] ──────────────────────────────────
    let nums: [i64] := [3, 1, 4, 1, 5, 9, 2, 6];

    let first_big := find_first(nums, |x: &i64| -> boolean { *x > 4 }, |x: &i64| -> i64 { *x });
    assert(option_or(first_big, 0) == 5);

    let nums_huge: [i64] := [3, 1, 4, 1, 5, 9, 2, 6];
    let first_huge := find_first(
        nums_huge,
        |x: &i64| -> boolean { *x > 100 },
        |x: &i64| -> i64 { *x },
    );
    assert(!option_is_some(first_huge));

    let nums_even_count: [i64] := [3, 1, 4, 1, 5, 9, 2, 6];
    let evens_count := count_where(nums_even_count, |x: &i64| -> boolean { *x % 2 == 0 });
    assert(evens_count == 3);   // 4, 2, 6

    // ── map_array<i64, i64> and map_array<i64, boolean> ──────────────────────────
    let nums_doubled: [i64] := [3, 1, 4, 1, 5, 9, 2, 6];
    let doubled_arr := map_array(nums_doubled, |x: &i64| -> i64 { *x * 2 });
    assert(doubled_arr.len() == 8);
    assert(doubled_arr[0] == 6);
    assert(doubled_arr[4] == 10);

    let nums_above_mean: [i64] := [3, 1, 4, 1, 5, 9, 2, 6];
    let above_mean: [boolean] := map_array(nums_above_mean, |x: &i64| -> boolean { *x > 4 });
    assert(!above_mean[0]);   // 3 <= 4
    assert(above_mean[5]);    // 9 > 4

    // ── Composing combinators ─────────────────────────────────────────────────
    // find_first in an array of Pairs: locate entry with value > 5
    let table_rich: [Pair<String, i64>] := [
        Pair { first = "apples",  second = 3  },
        Pair { first = "bananas", second = 7  },
        Pair { first = "cherries", second = 12 },
    ];
    let rich_entry := find_first(
        table_rich,
        |p: &Pair<String, i64>| -> boolean { (*p).second > 5 },
        |p: &Pair<String, i64>| -> Pair<String, i64> {
            Pair {
                first = (*p).first.substring(0, (*p).first.len()),
                second = (*p).second,
            }
        },
    );
    assert(option_is_some(rich_entry));
    let table_rich_again: [Pair<String, i64>] := [
        Pair { first = "apples",  second = 3  },
        Pair { first = "bananas", second = 7  },
        Pair { first = "cherries", second = 12 },
    ];
    let rich_entry_again := find_first(
        table_rich_again,
        |p: &Pair<String, i64>| -> boolean { (*p).second > 5 },
        |p: &Pair<String, i64>| -> Pair<String, i64> {
            Pair {
                first = (*p).first.substring(0, (*p).first.len()),
                second = (*p).second,
            }
        },
    );
    let rich_name := option_map(rich_entry_again, |p: Pair<String, i64>| -> String { p.first });
    assert(option_or(rich_name, "") == "bananas");

    // ── braceless if throughout (re-asserted inline) ──────────────────────────
    let sign := |x: i64| -> i64 { if (x > 0) 1 else if (x < 0) -1 else 0 };
    assert(sign(42) ==  1);
    assert(sign(-5) == -1);
    assert(sign(0)  ==  0);

    // ── id used again at f64 via map_array ──────────────────────────────────
    let floats: [f64] := [1.0, 2.0, 3.0];
    let same := map_array(floats, |x: &f64| -> f64 { id(*x) });
    assert(same[0] == 1.0);
    assert(same[2] == 3.0);
}
