// v0.16.0 integration: super-aspects and declaration clauses x bodyless aspects and extends x negative impls and bounds x
// conditional impls x bounds on structs and functions x associated types x dyn aspects.
aspect Marker;
aspect Named { fun name(&self) -> String; }
aspect Greeter requires Named { fun greet(&self) -> String; }
aspect Tagged { fun tag(&self) -> String; }
aspect Shape { type Unit; fun area(&self) -> i64; }

struct Dog derives Clone { n: i64 }
struct Cat { n: i64 }
struct Holder<T: Named> { inner: T }

extend Dog: Marker;
extend Cat: !Marker;
extend Dog: Named { fun name(&self) -> String { "dog" } }
extend Dog: Greeter { fun greet(&self) -> String { "hi ${self.name()}" } }
extend<T> Holder<T>: Named { fun name(&self) -> String { self.inner.name() } }
extend<T: Marker> Holder<T>: Tagged { fun tag(&self) -> String { "marked ${self.inner.name()}" } }
extend Cat: Shape {
    type Unit := i64;
    fun area(&self) -> i64 { self.n * 2 }
}

fun only_marked<T: Marker>(t: T) -> i64 { 1 }
fun only_unmarked<T: !Marker>(t: T) -> i64 { 2 }
fun both<T: Named + Marker>(t: T) -> String { t.name() }
fun greet_through<T: Greeter>(t: T) -> String { "${t.greet()}/${t.name()}" }

fun main() {
    let d := Dog(n = 1);
    let c := Cat(n = 2);
    let d2 := d.clone();
    assert(only_marked(d) == 1);
    assert(only_unmarked(Cat(n = 7)) == 2);
    assert(both(d2) == "dog");
    assert(greet_through(Dog(n = 3)) == "hi dog/dog");
    let h := Holder(inner = Dog(n = 4));
    assert(h.name() == "dog");
    assert(h.tag() == "marked dog");
    assert(c.area() == 4);
    let g: dyn Greeter := Dog(n = 5);
    assert(g.greet() == "hi dog");
}
