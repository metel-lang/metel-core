// metel-core#1616: `std::core::Result::Ok` in an expression names the core variant even where
// the module declares its own `Result`. The annotation fixes `E`, which the literal alone
// does not determine (that holds with or without the shadowing declaration).
enum Result { Good, Bad }

fun main() {
    let r: std::core::Result<i64, String> := std::core::Result::Ok { value = 1 };
    assert(r.unwrap_or(0) == 1);
}
