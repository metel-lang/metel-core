// metel-core#2201 (RFC-0100 section 7a): a qualified call on a variant path constructs
// that variant, the same way a bare struct-name call constructs a struct (metel-core#2199).
enum Message { Text { body: String }, Number { value: i64 } }
fun main() {
    let a := Message::Text(body = "hello");
    let b := Message::Number(42);
    match (a) {
        Message::Text { body } => assert(body == "hello"),
        _ => assert(false),
    }
    match (b) {
        Message::Number { value } => assert(value == 42),
        _ => assert(false),
    }
}
