// metel-core#2201 (RFC-0100 section 7a): a zero-argument call on a unit variant's path
// constructs it, alongside the existing bare/qualified unit-variant forms.
enum Message { Empty, Text { body: String } }
fun main() {
    let a := Message::Empty();
    let b := Message::Empty;
    match (a) {
        Message::Empty => assert(true),
        _ => assert(false),
    }
    match (b) {
        Message::Empty => assert(true),
        _ => assert(false),
    }
}
