// RFC-0100 section 7 (metel-core#2201): an expected enum type resolves an unqualified payload-variant
// call, as it does an unqualified variant literal (RFC-0111) -- and an in-scope binding of the same
// name takes precedence over the variant.
enum Shape { Circle { radius: i64 }, Square { side: i64 } }

fun area(shape: Shape) -> i64 {
    match (shape) {
        Shape::Circle { radius } => radius * radius * 3,
        Shape::Square { side } => side * side,
    }
}

fun main() {
    let some: Option<i64> := Some(value = 1);
    assert(some.unwrap_or(0) == 1);

    let shape: Shape := Square(side = 2);
    assert(area(shape) == 4);
    assert(area(Circle(radius = 1)) == 3);

    let Square := |side: i64| -> i64 { side + 100 };
    assert(Square(1) == 101);
}
