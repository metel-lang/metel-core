// metel-core#2201 (RFC-0100 section 7a): Enum::Variant(args) and the existing struct-style
// brace construction of the same variant with the same arguments produce the same value. The brace
// form is written in the enum's own `extend` block, the only place it is legal (RFC-0100 section 3).
enum Message { Text { body: String }, Empty }

extend Message {
    fun text_by_brace(body: String) -> Message { Message::Text { body = body } }
}

fun main() {
    let via_call := Message::Text(body = "hello".to_string());
    let via_brace := Message::text_by_brace("hello".to_string());
    let body_from_call := match (via_call) {
        Message::Text { body } => body,
        _ => "".to_string(),
    };
    let body_from_brace := match (via_brace) {
        Message::Text { body } => body,
        _ => "".to_string(),
    };
    assert(body_from_call == body_from_brace);

    let unit_via_call := Message::Empty();
    let unit_via_bare := Message::Empty;
    let is_empty_via_call := match (unit_via_call) {
        Message::Empty => true,
        _ => false,
    };
    let is_empty_via_bare := match (unit_via_bare) {
        Message::Empty => true,
        _ => false,
    };
    assert(is_empty_via_call == is_empty_via_bare);
}
