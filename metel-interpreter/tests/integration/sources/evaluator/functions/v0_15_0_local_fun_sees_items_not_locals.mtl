// metel-core#1714 (RFC-0195): a local `fun` sees module-level items, sibling local functions and local
// types, and takes everything else as a parameter. Mutual recursion among local functions is unchanged.
let LIMIT := 10;
fun helper(x: i64) -> i64 { x + 1 }
fun main() {
    record P { x: i64 }
    fun mk(v: i64) -> P { P { x = helper(v) } }
    fun is_even(n: i64) -> boolean { if (n == 0) { true } else { is_odd(n - 1) } }
    fun is_odd(n: i64) -> boolean { if (n == 0) { false } else { is_even(n - 1) } }
    fun twice(v: i64) -> i64 { mk(mk(v).x).x }
    fun limit() -> i64 { LIMIT } // a module-level binding is not a local of `main`
    var total := 0;
    fun add(t: i64, v: i64) -> i64 { t + v }
    total := add(total, twice(1));
    assert(total == 3);
    assert(is_even(10) && is_odd(7));
    assert(limit() == 10);
    let bump := [&var total] var || { total += 1; }; // a closure captures
    bump();
    assert(total == 4);
}
