// print/println must keep working when called through user helpers that are
// themselves generic over Display. This exercises the std::core Metel-bodied
// wrappers through the full graph pipeline, not only direct call sites.

struct User {
    name: String,
}

extend User: Display {
    fun to_string(&self) -> String {
        "User(${self.name})"
    }
}

enum Status {
    Ready,
    Busy,
}

extend Status: Display {
    fun to_string(&self) -> String {
        match (self) {
            Status::Ready => "ready",
            Status::Busy => "busy",
        }
    }
}

fun log_value<T: Display>(first: T, second: T) {
    print(first);
    println(second);
}

fun main() {
    log_value(User { name = "Ada" }, User { name = "Ada" });
    log_value(Status::Ready, Status::Ready);
    log_value(42, 42);
    log_value("done", "done");
}
