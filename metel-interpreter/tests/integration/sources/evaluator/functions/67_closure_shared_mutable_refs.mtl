fun get_closures() -> (|| -> (), || -> (), || -> i64) {
    var shared := 0;
    var ptr := &var shared;
    let first_ptr: &&var i64 := &ptr;
    let second_ptr: &&var i64 := &ptr;
    let third_ptr: &&var i64 := &ptr;
    let first_closure := || {
        **first_ptr += 1;
    };

    let second_closure := || {
        **second_ptr += 2;
    };

    let third_closure := || -> i64 {
        return **third_ptr;
    };

    return (first_closure, second_closure, third_closure);
}

fun main() {
    
    let closures := get_closures();
    
    let first_closure := closures.0;
    let second_closure := closures.1;
    let third_closure := closures.2;

    first_closure();
    first_closure();
    second_closure();
    assert(third_closure() == 4);

}
