// ── Auto-deref for function pointer calls ─────────────────────────────────────

// Calling &() -> T directly (no explicit ptr() needed beyond auto-deref)
//
// The `-> i64` here is load-bearing for a reason unrelated to what this fixture tests:
// an unannotated closure-valued `let` is typed `()` at the call site in pass 2
// (metel-core#281), so `ptr() == 42` would compare against `()`. That went unnoticed
// while `==` accepted operands of any type; metel-core#279's guard exposed it. Declaring
// the return type sidesteps #281 without weakening the guard.
fun test_immutable_fun_ptr_call() {
    let f := || -> i64 { return 42; };
    let ptr := &f;
    assert(ptr() == 42);
}

// &var () -> T is also auto-deref callable
fun test_mutable_fun_ptr_call() {
    var x := 0;
    var p := &var x;
    var inc := [&var p] var || { *p += 7; };
    let mut_ptr := &var inc;
    mut_ptr();
    assert(x == 7);
}

// Function taking &() -> T and calling it directly
fun call_via_ptr(f: &|| -> i64) -> i64 {
    return f();
}

fun test_fun_ptr_param() {
    let f := || { return 99; };
    assert(call_via_ptr(&f) == 99);
}

// Array<&() -> ()> — iteration and call via auto-deref
fun apply_ptrs(fns: Array<&|| -> ()>) {
    for (f in fns) {
        f();
    }
}

fun test_array_of_fun_ptrs() {
    var total := 0;
    let ptr := &var total;
    let ptr1: &&var i64 := &ptr;
    let ptr2: &&var i64 := &ptr;
    let add1 := || { **ptr1 += 1; };
    let add10 := || { **ptr2 += 10; };
    apply_ptrs([&add1, &add10]);
    assert(total == 11);
}

// ── Closures capturing function pointers ──────────────────────────────────────

// A closure that captures a &() -> () variable and calls it.
// Before auto-deref, this required (*inc_ptr)() inside the outer closure.
fun test_closure_captures_fun_ptr() {
    var x := 0;
    var p: &var i64 := &var x;
    var inc := [&var p] var || { *p += 1; };
    var inc_ptr: &var var || -> () := &var inc;
    var double_via_ptr := [&var inc_ptr] var || -> () {
        inc_ptr();                   // auto-deref: calls the captured reference
        inc_ptr();
    };
    double_via_ptr();
    assert(x == 2);
}

// Same pattern, but the reference is &var () -> ()
fun test_closure_captures_mut_fun_ptr() {
    var x := 0;
    var p: &var i64 := &var x;
    var add5 := [&var p] var || { *p += 5; };
    var ptr := &var add5;
    var triple := [&var ptr] var || -> () {
        ptr();
        ptr();
        ptr();
    };
    triple();
    assert(x == 15);
}

// ── Closure capture-by-value semantics ────────────────────────────────────────

// Closures capture variables BY VALUE at creation time.
// Mutations inside the closure do not affect the outer binding.
fun test_capture_by_value() {
    var x := 0;
    var f := var || { x += 1; };
    f();
    f();
    f();
    // x in this scope is unchanged — f modified its own captured copy
    assert(x == 0);
}

// Using &var explicitly shares the mutation back to the outer scope.
fun test_capture_via_pointer_propagates() {
    var x := 0;
    var ptr: &var i64 := &var x;
    var f := [&var ptr] var || { *ptr += 1; };
    f();
    f();
    f();
    // Mutation is visible because it went through the shared reference
    assert(x == 3);
}

fun main() {
    test_immutable_fun_ptr_call();
    test_mutable_fun_ptr_call();
    test_fun_ptr_param();
    test_array_of_fun_ptrs();
    test_closure_captures_fun_ptr();
    test_closure_captures_mut_fun_ptr();
    test_capture_by_value();
    test_capture_via_pointer_propagates();
}
