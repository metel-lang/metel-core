fun main() {
    var value := 1;
    let captured := || -> i64 {
        value
    };
    value := 9;

    var shared := 0;
    var ptr := &var shared;
    var bump := [&var ptr] var || -> i64 {
        *ptr += 1;
        *ptr
    };

    let first := bump();
    let second := bump();

    assert(captured() == 1);
    assert(first == 1);
    assert(second == 2);
}
