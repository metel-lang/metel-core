// Test: multi-param generic enum variant construction where some type params
// are not mentioned in the variant fields — the unmentioned param must be
// inferred from surrounding context (let annotation, return type, if-else arms).
// Covers issue #129.

enum Either<L, R> {
    Left  { val: L },
    Right { val: R },
}

fun either_map_left<L, R, M>(e: Either<L, R>, f: |L| -> M) -> Either<M, R> {
    match (e) {
        Either::Left  { val } => Either::Left  { val = f(val) },
        Either::Right { val } => Either::Right { val = val },
    }
}

fun either_is_left<L, R>(e: Either<L, R>) -> boolean {
    match (e) {
        Either::Left  { val } => true,
        Either::Right { val } => false,
    }
}

fun either_left_or<L, R>(e: Either<L, R>, default: L) -> L {
    match (e) {
        Either::Left  { val } => val,
        Either::Right { val } => default,
    }
}

fun either_right_or<L, R>(e: Either<L, R>, default: R) -> R {
    match (e) {
        Either::Left  { val } => default,
        Either::Right { val } => val,
    }
}

fun classify(n: i64) -> Either<i64, String> {
    if (n > 0) { Either::Left { val = n } }
    else       { Either::Right { val = "non-positive" } }
}

fun main() {
    // Explicit annotation provides the missing type param
    let l: Either<i64, String> := Either::Left  { val = 42 };
    let r: Either<i64, String> := Either::Right { val = "hello" };

    assert(either_is_left(l));
    assert(!either_is_left(r));
    let l_again: Either<i64, String> := Either::Left  { val = 42 };
    let r_again: Either<i64, String> := Either::Right { val = "hello" };
    assert(either_left_or(l_again, 0)   == 42);
    assert(either_right_or(r_again, "") == "hello");

    // map_left: Left(42) → Left(84)
    let doubled_input: Either<i64, String> := Either::Left { val = 42 };
    let doubled := either_map_left(doubled_input, |x: i64| -> i64 { x * 2 });
    match (doubled) {
        Either::Left { val } => assert(val == 84),
        Either::Right { val } => assert(false),
    };

    // map_left on Right: Right passes through unchanged
    let pass_input: Either<i64, String> := Either::Right { val = "hello" };
    let pass := either_map_left(pass_input, |x: i64| -> i64 { x + 1 });
    assert(!either_is_left(pass));

    // Type inference from if-else arms in a function with return annotation
    let pos := classify(5);
    let neg := classify(-3);
    assert(either_is_left(pos));
    assert(!either_is_left(neg));
    assert(either_left_or(classify(5),  0)  == 5);
    assert(either_right_or(classify(-3), "") == "non-positive");

    // Either<boolean, i64>
    let b: Either<boolean, i64> := Either::Left  { val = true };
    let n: Either<boolean, i64> := Either::Right { val = 99 };
    assert(either_is_left(b));
    assert(!either_is_left(n));
    let b_again: Either<boolean, i64> := Either::Left { val = true };
    let n_again: Either<boolean, i64> := Either::Right { val = 99 };
    assert(either_left_or(b_again, false));
    assert(either_right_or(n_again, 0) == 99);
}
