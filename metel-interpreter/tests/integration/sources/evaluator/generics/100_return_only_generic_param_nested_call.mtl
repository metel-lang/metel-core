// Regression (metel-core#716): the real root cause behind List::map's failure, isolated
// from the stdlib entirely. A generic function whose own type parameter is recoverable
// only from its *return* type (no argument mentions it) failed to construct its body at
// call time whenever that body itself called another such zero-argument generic function
// -- construct_generic_body had no way to see the outer call's own expected return type,
// only argument types, so the inner call's type parameter stayed permanently unresolved.

fun make<V>() -> [V] { [] }

fun wrapper<U>() -> [U] {
    let out: [U] := make();
    out
}

fun main() {
    let r: [i64] := wrapper();
    assert(r.len() == 0);
    println("ok");
}
