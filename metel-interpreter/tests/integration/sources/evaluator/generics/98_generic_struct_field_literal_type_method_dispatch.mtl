// Regression test for issue #236: a generic struct field's concrete type,
// recovered from the literal used to construct it (ADR-0043/#267's field-value
// type recovery), was not propagated far enough to resolve method dispatch on
// that field — `p.first.to_string()` failed with T0002 ("cannot infer receiver
// type") even though `p.first`'s type was fully known.
//
// Root cause: an unsuffixed integer/float literal gets its own TypeVar, tagged
// in InferContext as an "integer/float literal var" so it can be defaulted to
// i64/f64 if still free at the point something needs a concrete type.
// Constructing a generic struct mints a *separate*, fresh TypeVar per type
// parameter and constrains it equal to the field's value type — so
// `Pair { first = 1, .. }.first` carries that fresh TypeVar, merely unified
// with (not identical to) the literal's own tagged TypeVar. Method-call
// receiver defaulting checked literal-ness with a bare TypeVar-identity
// lookup, which missed this one level of indirection; arithmetic and
// explicitly-annotated bindings already went through `default_literal_vars`,
// which walks the chain correctly — that's why `p.first + p.second` and
// `let a: i64 = p.first` both worked while `p.first.to_string()` did not.

struct Pair<A, B> { first: A, second: B }

fun main() {
    let p := Pair { first = 1, second = "one" };

    // The issue's own repro: direct method dispatch on an unannotated field.
    assert(p.first.to_string() == "1");

    // Confirmed broken independently of method dispatch syntax — string
    // interpolation calls `.to_string()` on each interpolated expression.
    assert("${p.first} / ${p.second}" == "1 / one");

    // Confirmed broken even one level removed: copying the field into an
    // unannotated local first did not help, since the copy's own TypeVar is
    // yet another fresh var unified with the same chain.
    let copied := p.first;
    assert(copied.to_string() == "1");

    // Float literals are tagged and defaulted the same way as integers —
    // cover that path too, not just i64.
    let q := Pair { first = 2.5, second = "half" };
    assert(q.first.to_string() == "2.5");

    // Two hops through unannotated locals, to exercise a longer chain of
    // unifications rather than just the one hop the issue's own repro shows.
    let first_copy := q.first;
    let twice := first_copy;
    assert(twice.to_string() == "2.5");

    // Arithmetic and an explicit type annotation on a copy were never broken
    // (both already went through `default_literal_vars`) — pinned here so a
    // future change can't quietly break the cases this bug's own workaround
    // relied on.
    assert(p.first + 4 == 5);
    let annotated: i64 := p.first;
    assert(annotated.to_string() == "1");
}
