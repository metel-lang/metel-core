// metel-core#1556: a struct, record or enum declared in a function body can have type parameters.
// Before, the parameter was dropped and every use failed with `cannot unify ... 'T'`.
fun id<T>(v: T) -> T { v }

fun main() {
    record Box<T> { x: T }
    let b := Box { x = 1 };
    assert(b.x == 1);

    // The written type argument and the constructed one agree, and a field reads at it.
    let annotated: Box<i64> := Box { x = 2 };
    let n: i64 := annotated.x;
    assert(n == 2);

    struct Pair<A, B> { a: A, b: B }
    var p := Pair { a = id(3), b = "s" };
    assert(p.a == 3);
    assert(p.b == "s");
    p.a := 5;
    assert(p.a == 5);
    let q: Pair<i64, String> := p;

    // A parameter no field mentions comes from the expected type.
    record Marker<T> {}
    let m: Marker<i64> := Marker {};

    enum Opt<T> { Some { value: T }, None }
    var got := 0;
    match (Opt::Some { value = 7 }) {
        Opt::Some { value } => { got := value; },
        Opt::None => { got := -1; },
    }
    assert(got == 7);
    let none: Opt<i64> := Opt::None;
    match (none) {
        Opt::Some { value } => { got := value; },
        Opt::None => { got := 0; },
    }
    assert(got == 0);
}
