// Test: explicit type annotations using generic type params inside function bodies
// Covers issue #128: T/U in body annotations must resolve to TypeVars, not Named types.

// Ownership workaround (#328): `[T]` is a borrowed view, so a non-`Copy` element cannot be
// moved out of it -- #329 enforces that. Indexing plus an explicit clone callback makes
// retained values owned. The callback is scaffolding, not part of what this fixture tests;
// it goes away once `Clone` has stdlib coverage, or sooner via a `T: Copy` bound where
// the elements are `Copy` (#335, #328).
fun collect_matching<T>(arr: [T], pred: |&T| -> boolean, clone: |&T| -> T) -> List<T> {
    var result: List<T> := List::new();
    var i := 0;
    while (i < arr.len()) {
        if (pred(&arr[i as u64])) {
            result.push(clone(&arr[i as u64]));
        }
        i += 1;
    }
    result
}

fun map_to<T, U>(arr: [T], f: |&T| -> U) -> List<U> {
    var out: List<U> := List::new();
    for (x in arr) { out.push(f(&x)); }
    out
}

fun wrap_pair<A, B>(a: A, b: B) -> List<A> {
    var items: List<A> := List::new();
    items.push(a);
    items
}

fun main() {
    let nums_for_evens: [i64] := [1, 2, 3, 4, 5, 6];
    let evens := collect_matching(
        nums_for_evens,
        |x: &i64| -> boolean { *x % 2 == 0 },
        |x: &i64| -> i64 { *x },
    );
    assert((&evens).len() == 3);
    let evens_arr := (&evens).as_slice();
    assert(evens_arr[0] == 2);

    let strs: [String] := ["a", "bb", "ccc", "dddd"];
    let long := collect_matching(
        strs,
        |s: &String| -> boolean { (*s).len() > 2 },
        |s: &String| -> String { (*s).substring(0, (*s).len()) },
    );
    assert(long.len() == 2);

    let nums_for_squares: [i64] := [1, 2, 3, 4, 5, 6];
    let squares := map_to(nums_for_squares, |x: &i64| -> i64 { *x * *x });
    assert((&squares).len() == 6);
    let squares_arr := (&squares).as_slice();
    assert(squares_arr[0] == 1);
    assert(squares_arr[5] == 36);

    let nums_for_bools: [i64] := [1, 2, 3, 4, 5, 6];
    let bools := map_to(nums_for_bools, |x: &i64| -> boolean { *x > 3 });
    assert((&bools).len() == 6);
    let bools_arr := (&bools).as_slice();
    assert(!bools_arr[0]);
    assert(bools_arr[5]);

    let wrapped := wrap_pair(42, true);
    assert((&wrapped).len() == 1);
    let wrapped_arr := (&wrapped).as_slice();
    assert(wrapped_arr[0] == 42);
}
