// v0.13.0 closure cluster (RFC 0157 base / dynamics-11): when a closure value
// is dropped its environment is dropped -- each owned capture dropped in
// capture-list order, as a struct's fields are. A once-consumed or
// partially-moved environment drops only its still-owned captures.
//
// This fixture remains skipped pending metel-core#261 (destructor invocation):
// non-empty `drop` bodies are rejected until then, so the *order* claim cannot
// yet be asserted with an observable side effect. It only checks that captures
// are held and the closure runs.
struct Owned {
    id: i64,
}

fun main() {
    let a := Owned { id = 1 };
    let b := Owned { id = 2 };
    let f := [a, b] || { a.id + b.id };
    assert(f() == 3);
    // at scope end `f` drops: `a` then `b`, capture-list order.
}
