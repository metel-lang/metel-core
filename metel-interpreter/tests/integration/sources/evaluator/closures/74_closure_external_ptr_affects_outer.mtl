// A &var reference created in the outer scope and captured by a closure retains its
// connection to the original binding: deep_clone_value preserves the inner Rc of a
// reference value rather than copying it. Mutations through the captured reference
// must be visible in the outer scope.
fun main() {
    var x := 10;
    let p: &var i64 := &var x;
    let p_ref: &&var i64 := &p;

    let f := || -> () {
        **p_ref := 42;
    };

    f();

    assert(x == 42);

    // The reference itself is also usable directly after the call.
    assert(*p == 42);
}
