// metel-core#1676 (RFC 0153 legality-25): a `&self` call only reads the capture, so no
// `var` is needed.
struct S { n: i64 }
extend S: Copy;
extend S {
    fun inc(&var self) { self.n := self.n + 1; }
    fun get(&self) -> i64 { self.n }
}

fun main() {
    var s := S { n = 3 };
    let f := || { s.get() };
    assert(f() == 3);
}
