// metel-core#1684 (RFC 0153 legality-25): written with `var`, a closure in a generic body may write
// and call `&var self` on its captures; the outer binding is unchanged. The function is called, so
// the body is also reconstructed per instantiation.
aspect Bump { fun bump(&var self); }
struct C { n: i64 }
extend C: Copy;
extend C: Bump { fun bump(&var self) { self.n := self.n + 1; } }

fun run<T: Bump + Copy>(x: T) {
    var v := x;
    var assign := var || { v := x; };
    assign();
    var bump := var || { v.bump(); };
    bump();
}

fun main() {
    run(C { n = 0 });
}
