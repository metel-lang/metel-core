// metel-core#1676 (RFC 0153 legality-25): `[&var s] var` shares the binding, so the
// call updates the outer value.
struct S { n: i64 }
extend S: Copy;
extend S {
    fun inc(&var self) { self.n := self.n + 1; }
    fun get(&self) -> i64 { self.n }
}

fun main() {
    var s := S { n = 0 };
    var f := [&var s] var || { s.inc(); };
    f();
    f();
    assert(s.n == 2);
}
