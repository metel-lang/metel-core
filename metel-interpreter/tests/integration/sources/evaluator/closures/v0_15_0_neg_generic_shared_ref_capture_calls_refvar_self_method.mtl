// metel-core#1684 (RFC 0153 legality-25): a `[&v]` capture is read-only, so the call asks for `&var`.
aspect Bump { fun bump(&var self); }
struct C { n: i64 }
extend C: Copy;
extend C: Bump { fun bump(&var self) { self.n := self.n + 1; } }

fun run<T: Bump + Copy>(x: T) {
    var v := x;
    let f := [&v] || { v.bump(); };
}

fun main() { }
