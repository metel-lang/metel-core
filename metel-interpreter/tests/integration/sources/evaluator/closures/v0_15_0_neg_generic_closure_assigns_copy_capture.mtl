// metel-core#1684 (RFC 0153 legality-25): the `var` check holds at a generic definition. This
// function is never called, and its closure is rejected where it is written, not at a first call.
fun run<T: Copy>(x: T) {
    var v := x;
    let f := || { v := x; }; // missing `var` qualifier
}

fun main() { }
