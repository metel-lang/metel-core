// Inside a generic function a closure's annotations may name the enclosing function's row variable,
// in the parameter position, the return position or both. A closure nested in a closure, and a
// return type left to inference, are their own fixture.
fun keep<record R>(r: .{ .x: i64, ..R }) -> i64 {
    let f := |p: .{ .x: i64, ..R }| -> .{ .x: i64, ..R } { p };
    return f(r).x;
}

fun param_only<record R>(r: .{ .x: i64, ..R }) -> i64 {
    let g := |p: .{ .x: i64, ..R }| -> i64 { p.x + 1 };
    return g(r);
}

fun main() {
    assert(keep(.{ .x = 1, .y = 2 }) == 1);
    assert(param_only(.{ .x = 1, .z = "z" }) == 2);
}
