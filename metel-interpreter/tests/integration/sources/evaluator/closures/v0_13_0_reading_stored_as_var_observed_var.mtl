// v0.13.0 closure cluster (RFC 0152 dynamics-14): storing a `reading` closure
// into a `var`-typed field coerces it into that field's declared type -- a
// one-way precision loss. Later reads of the field yield a `var` value; there
// is no automatic re-narrowing back to `reading`.
//
struct Box {
    run: var || -> i64,
}

fun main() {
    let pure := || { 3 }; // `reading`
    let b := Box { run = pure };  // coerced into the `var`-typed field
    assert((b.run)() == 3);       // `b.run` is observed as `var () -> i64`
}
