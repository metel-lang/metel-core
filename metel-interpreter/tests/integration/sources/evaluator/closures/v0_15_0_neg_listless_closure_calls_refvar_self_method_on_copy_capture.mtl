// metel-core#1676 (RFC 0153 legality-25): the same call on an implicitly captured `Copy`
// binding, with the capture list omitted.
struct S { n: i64 }
extend S: Copy;
extend S {
    fun inc(&var self) { self.n := self.n + 1; }
    fun get(&self) -> i64 { self.n }
}

fun main() {
    var s := S { n = 0 };
    let f := || { s.inc(); }; // missing `var` qualifier
    f();
}
