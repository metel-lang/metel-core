// metel-core#1676 (RFC 0153 legality-25): a binding the closure declares is not a capture.
struct S { n: i64 }
extend S: Copy;
extend S {
    fun inc(&var self) { self.n := self.n + 1; }
    fun get(&self) -> i64 { self.n }
}

fun main() {
    let f := || {
        var t := S { n = 0 };
        t.inc();
        t.get()
    };
    assert(f() == 1);
}
