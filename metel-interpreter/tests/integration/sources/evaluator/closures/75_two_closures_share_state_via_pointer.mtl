// RFC-0006 §3: two closures may share mutable state only via an explicit shared
// pointer. Both `inc` and `read` capture the same `&var i64`; a write through
// one is visible through the other -- not because the closures share an
// implicit environment, but because they share the pointer value itself.
fun main() {
    var x := 10;
    let p: &var i64 := &var x;

    let inc := [p] var || -> () {
        *p += 1;
    };
    inc();
    inc();

    // `p` is move-only, so only `inc` holds it; `read` snapshots `x` once `inc` is done,
    // which sees the writes `inc` made through the pointer.
    let read := [x] || -> i64 {
        x
    };
    assert(read() == 12);
}
