// metel-core#1688: generalizing a `let`-bound closure against the solved environment must not make
// it less polymorphic: `id` does not depend on `base`, so it is still used at two types, while
// `plus` captures `base`. (A closure like `id` inside a *generic* function is a separate move-check
// gap, `--move-check` I0011: "abstract signature contains an unquantified variable", metel-core#1691.)
fun main() {
    let base := 10;
    let id := |y| { y };
    let plus := |n: i64| { n + base };
    assert(id(1) == 1);
    assert(id(true));
    assert(plus(5) == 15);
}
