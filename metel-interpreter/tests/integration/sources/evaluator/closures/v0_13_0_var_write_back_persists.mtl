// v0.13.0 closure cluster (RFC 0153 dynamics-7): a `mutating` closure's
// writes to its by-value captures persist across calls -- private mutable
// state, with no per-call re-clone (RFC 0157 D5 is the base this relies on).
//
fun make_counter() -> var || -> i64 {
    let n := 0;
    [n] var || { n = n + 1; n }
}

fun main() {
    var c := make_counter(); // `var`: each `c()` is a `&var self`-shaped borrow of `c` (legality-10)
    assert(c() == 1);
    assert(c() == 2); // state lives in `c`'s environment, not re-cloned
}
