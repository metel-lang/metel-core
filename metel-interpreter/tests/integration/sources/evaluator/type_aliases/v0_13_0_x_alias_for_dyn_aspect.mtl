// Cross-feature (v0.13.0): a transparent type alias (RFC-0160) whose right-hand
// side is an aspect-object type (RFC-0008, `dyn Aspect`). The alias is erased to
// `dyn Draw` before name resolution and type checking, so coercion into it,
// dynamic dispatch through it, and a `List<>` of it behave exactly as if
// `dyn Draw` were written directly.

aspect Draw {
    fun ink(&self) -> i64;
}

struct Dot  { weight: i64 }
struct Dash { weight: i64 }

extend Dot:  Draw { fun ink(&self) -> i64 { self.weight } }
extend Dash: Draw { fun ink(&self) -> i64 { self.weight * 3 } }

type Glyph := dyn Draw;

fun stroke(g: &Glyph) -> i64 { g.ink() }

fun main() {
    // coercion of a concrete value into the alias, in `let` and argument position
    let a: Glyph := Dot(weight = 2);
    assert(stroke(&a) == 2);

    // a List of the alias holds different concrete types, dispatched at runtime
    var glyphs: List<Glyph> := List::new();
    glyphs.push(Dot(weight = 1));
    glyphs.push(Dash(weight = 4));
    var total := 0;
    for (g in glyphs.as_slice()) {
        total = total + g.ink();
    }
    // Dot 1  +  Dash 4*3  =  1 + 12 = 13
    assert(total == 13);
    println("ok");
}
