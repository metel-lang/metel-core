// An inferred-signature parameter used as an operator operand is still analysed
// at definition time: the operator only observes it, so the later moves are
// what the checker must see (#273).
fun twice_move(v) {
    let sum := v + v;
    let a := v;
    let b := v;
    sum
}

fun main() {
    assert(twice_move(1) == 2);
}
