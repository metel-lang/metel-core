// Arithmetic and ordering on inferred closure parameters keep their operation in the
// abstract body without sampling a concrete operand type (#273). A named function writes
// its parameter types (RFC-0193), and a closure has one type (RFC-0196), so each operand
// type gets its own closure here.
fun main() {
    let double_int := |value| { value + value };
    let double_str := |value| { value + value };
    let larger := |a, b| { if (a < b) { b } else { a } };
    assert(double_int(21) == 42);
    assert(double_str("ab") == "abab");
    assert(larger(3, 9) == 9);
}
