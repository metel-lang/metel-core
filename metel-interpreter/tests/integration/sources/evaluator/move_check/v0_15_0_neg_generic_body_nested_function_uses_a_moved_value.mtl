// metel-core#1732: the nested function's own body is analysed. It is not constructed with its generic
// parent, so skipping it would have accepted this double move.
fun run<T>(x: T) -> T {
    fun twice(s: String) -> i64 {
        let a := s;
        let b := s;
        0
    }
    twice("a".to_string());
    x
}

fun main() {
    run(1);
}
