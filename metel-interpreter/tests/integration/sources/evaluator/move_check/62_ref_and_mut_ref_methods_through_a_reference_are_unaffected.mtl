aspect Show {
    fun show(&self) -> String;
}

aspect Bump {
    fun bump(&var self);
}

struct B {
    v: String,
}

extend B: Show {
    fun show(&self) -> String {
        return self.v.clone();
    }
}

struct C {
    v: i64,
}

extend C: Bump {
    fun bump(&var self) {
        self.v = self.v + 1;
    }
}

// `&self` and `&var self` methods are the ordinary borrowing shapes and must
// keep working through a reference, repeatedly — #348 is only about a
// by-value receiver.
fun main() {
    let b := B(v = "x");
    let r := &b;
    assert(r.show() == "x");
    assert(r.show() == "x");

    var c := C(v = 0);
    let rc := &var c;
    rc.bump();
    rc.bump();
    assert(c.v == 2);
}
