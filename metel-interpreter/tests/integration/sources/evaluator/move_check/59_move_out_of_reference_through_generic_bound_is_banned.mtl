aspect Consume {
    fun eat(self) -> String;
}

struct B {
    v: String,
}

extend B: Consume {
    fun eat(self) -> String {
        return self.v;
    }
}

// The concrete and generic paths must agree — the mistake #347 had to correct
// in the other direction. `consume_method_receiver` is the single place both
// resolve through, so there is no second copy of this rule to drift.
fun twice<T: Consume>(x: &T) -> String {
    let a := x.eat();
    return x.eat();
}

fun main() {
    let b := B { v = "owned" };
    let result := twice(&b);
}
