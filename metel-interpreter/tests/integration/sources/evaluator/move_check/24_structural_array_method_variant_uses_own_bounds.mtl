// Structural array methods share the same name-keyed registry pressure as
// nominal methods. The !Copy body must not inherit the later Copy bound.
aspect NonCopyTake {
    fun take_twice(self) -> i64;
}

aspect CopyTake {
    fun take_twice(self) -> i64;
}

extend<T: !Copy> [T]: NonCopyTake {
    fun take_twice(self) -> i64 {
        let first := self[0];
        let second := self[0];
        0
    }
}

extend<T: Copy> [T]: CopyTake {
    fun take_twice(self) -> i64 {
        let first := self[0];
        let second := self[0];
        0
    }
}

fun main() { }
