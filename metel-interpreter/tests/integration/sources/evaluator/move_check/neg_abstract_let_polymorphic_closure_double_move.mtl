// A `let`-bound closure is checked from its definition-time body, so a double move of its
// unannotated parameter is rejected (#273). The parameter is a `String`, fixed by the call (RFC-0196:
// a closure has one type, so an `i64` call would make it `Copy`).
fun main() {
    let dup := |v| {
        let first := v;
        let second := v;
        first
    };
    let kept := dup("a".to_string());
}
