// metel-core#1732: and a function nested in a nested function.
fun run<T>(x: T) -> T {
    fun outer(n: i64) -> i64 {
        fun inner(s: String) -> i64 {
            let a := s;
            let b := s;
            0
        }
        inner("a".to_string())
    }
    x
}

fun main() {
    run(1);
}
