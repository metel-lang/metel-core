// RFC-0036: an impl block may declare its own generics with an inline bound
// (`impl<T: Bound> Aspect for Type<T>`). Real bound-satisfaction checking at each
// instantiation (rejecting an unsatisfying T) is issue #241's job, not this one's —
// this fixture locks in that the syntax parses, constructs, and dispatches,
// including a call to another bounded method (`to_string()` via `Display`) on the
// generic field itself — issue #267's regression coverage lives here too, since
// that gap was found while first writing this fixture.

struct Box1<T> {
    value: T,
}

aspect Greet {
    fun greet(&self) -> String;
}

extend<T: Display> Box1<T>: Greet {
    fun greet(&self) -> String {
        return "hello, " + self.value.to_string();
    }
}

fun main() {
    let a := Box1 { value = 5 };
    assert(a.greet() == "hello, 5");
}
