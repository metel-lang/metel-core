// RFC-0081: `impl !Aspect for Type {}` (negative impls) parses with an empty body
// and does not register the type as implementing the aspect. Full negative-impl
// coherence (finality, priority over blanket impls) is issue #264's job — this
// fixture only locks in that the syntax is accepted and harmless alongside
// ordinary positive impls elsewhere in the same program.

struct Handle {
    fd: i64,
}

extend Handle: !Drop;

aspect Greet {
    fun greet(&self) -> String;
}

extend Handle: Greet {
    fun greet(&self) -> String {
        return "handle";
    }
}

fun main() {
    let h := Handle { fd = 3 };
    assert(h.greet() == "handle");
}
