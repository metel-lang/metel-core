// Positive: `[T]: Display` is itself conditional on `T: Display` (RFC-0061
// §2/§4), so it must apply recursively when `T` is itself an array -- an
// array-of-arrays is Display as long as the innermost element type is.
// Exercises `type_satisfies_aspect`'s `Type::Array` arm recursing through
// `check_conditional_entry` on a nested `Type::Array` argument rather than a
// `Named`/primitive one.

fun main() {
    let grid: [[i64]; 2] := [[1, 2], [3, 4]];
    assert(grid.to_string() == "[[1, 2], [3, 4]]");
}
