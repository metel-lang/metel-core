// metel-core#989: `helper` declares an aspect `Shape` with `area`, and `main`
// only ever uses *this* `Shape` as `dyn Shape`.
pub aspect Shape {
    fun area(&self) -> f64;
}

pub struct Circle { pub radius: f64 }

extend Circle: Shape {
    fun area(&self) -> f64 { 3.14159 * self.radius * self.radius }
}
