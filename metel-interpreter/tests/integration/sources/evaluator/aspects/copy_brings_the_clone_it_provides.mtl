// RFC-0206 section 2, RFC-0213 section 4: `aspect Copy: deriving Clone` is `implicit`, so the compiler
// provides the `Clone` of a `Copy` type: `derives Copy` and `copy struct` each bring it, and `T: Copy`
// proves `T: Clone`.
copy struct Point { x: i64, y: i64 }
struct Pixel derives Copy { v: i64 }
copy struct Wrapper<T> { v: T }
copy enum Dir { Up, Down }

fun dup<T: Copy>(x: &T) -> T { x.clone() }
fun need_clone<T: Clone>(x: &T) -> T { x.clone() }
fun via_copy<T: Copy>(x: &T) -> T { need_clone(x) }

fun main() {
    let p := Point(x = 1, y = 2);
    assert(p.clone().x == 1);
    assert(dup(&p).y == 2);
    assert(via_copy(&Pixel(v = 3)).v == 3);
    assert(Wrapper(v = 5).clone().v == 5);
    let down := Dir::Down;
    match (need_clone(&down)) { Dir::Down => assert(true), Dir::Up => assert(false) }
}
