// decoy::Metric declares a *same-named method* `value` with a different return
// type (i64). The issue (metel-core#989) flags this exact shape as one whose
// safety wasn't guaranteed before the per-module rekey: if `dyn Metric` dispatch
// picked decoy's aspect, `v` below would be typed i64 and the f64 arithmetic
// would fail.
pub aspect Metric {
    fun value(&self) -> i64;
}
pub fun marker() -> i64 { 0 }
