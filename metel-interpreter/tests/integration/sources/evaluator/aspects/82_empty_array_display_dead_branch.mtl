// Regression for #271: an empty collection's generic method dispatch used to
// default its element type to `Unit` when reconstructing the method body at
// call time (`construct_generic_body`), which then failed to typecheck any
// branch that called a non-`Unit` method on an element -- even when that
// branch is provably dead for an empty collection at runtime (`self.len() ==
// 0` guards it). std::core's own `impl<T: Display> Display for T[]`'s
// `to_string` has exactly this shape: a `for (item in self)` loop whose body
// calls `item.to_string()`, never executed for an empty array, but previously
// still typechecked eagerly against the bogus `Unit` placeholder.
//
// Fixed by defaulting the unrecoverable element type to `Never` (the bottom
// type, coercing to anything) instead of `Unit`, and making method-call
// construction on a `Never`-typed receiver defer to runtime dynamic dispatch
// rather than erroring.

fun main() {
    let empty: [i64] := [];
    assert(empty.to_string() == "[]");

    let nonempty: [i64] := [1, 2, 3];
    assert(nonempty.to_string() == "[1, 2, 3]");
}
