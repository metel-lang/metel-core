// User-defined Iterable via aspect — for-in dispatches through next().

aspect Iterable<T> {
    fun next(&var self) -> Option<T>;
}

struct Counter {
    current: i64,
    limit:   i64,
}

extend Counter {
    fun new(limit: i64) -> Counter {
        return Counter { current = 0, limit = limit };
    }
}

extend Counter: Iterable<i64> {
    fun next(&var self) -> Option<i64> {
        if (self.current < self.limit) {
            let val := self.current;
            self.current := self.current + 1;
            return Option::Some { value = val };
        }
        return None;
    }
}

fun main() {
    var sum := 0;
    let c := Counter::new(5);
    for (x in c) {
        sum += x;
    }
    assert(sum == 10); // 0+1+2+3+4
}
