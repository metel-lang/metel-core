// RFC-0244: a bare `derives` and `copy` state no condition, so the type is Copy for every argument; `derives Clone(..), Copy(..)` computes the
// condition from the fields, so `Boxed<String>` is Clone but not Copy.
copy struct Id<T> { n: i64 }
struct Boxed<T> derives Clone(..), Copy(..) { value: T }
struct Pair<A, B> derives Clone(..) { a: A, b: B }
struct Tag<T> derives Clone { n: i64 }

fun main() {
    let i: Id<String> := Id(n = 2);
    let j := i;
    let k := i;
    assert(j.n + k.n == 4);

    let b := Boxed(value = 3);
    let c := b;
    assert(b.value + c.value == 6);
    let s := Boxed(value = "s");
    let t := s.clone();
    assert(t.value == "s");

    let p := Pair(a = 1, b = "x");
    let q := p.clone();
    assert(q.a == 1);

    let g: Tag<String> := Tag(n = 7);
    assert(g.clone().n == 7);
}
