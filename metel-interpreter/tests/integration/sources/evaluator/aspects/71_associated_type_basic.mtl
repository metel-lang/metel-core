// RFC-0082: `type Name: Bound;` inside an `aspect` block and `type Name = Concrete;`
// inside its `impl` parse, construct, and dispatch through ordinary method calls
// on a concrete (non-generic) receiver. See 74_projection_call_site_resolution.mtl
// for real projection resolution (`T::AssocType`) through a generic function, and
// stage13_04/stage13_10 in typechecking/aspects for equality-constrained bounds
// (`Aspect<AssocType = Concrete>`) — both implemented as of issue #242.

aspect Container {
    type Item: Display;
    fun get(&self) -> Item;
}

struct IntBox {
    value: i64,
}

extend IntBox: Container {
    type Item := i64;
    fun get(&self) -> i64 {
        return self.value;
    }
}

fun main() {
    let b := IntBox { value = 42 };
    assert(b.get() == 42);
}
