// RFC-0036 + core Iterable: a *generic* struct implementing `Iterable<T>`
// generically (`extend<T: Clone> Wrapper<T>: Iterable<T> { ... }`), iterated via
// `for (x in w)` sugar, not a direct `.next()` call. Every existing Iterable
// fixture implements it for a concrete, non-generic target (e.g. `Counter:
// Iterable<i64>`), so this is the first to exercise the generic case through
// `for-in`.
//
// Regression for #257 (registry corruption) and a related dispatch gap it
// exposed: for-in's element-type derivation went through two separate lookup
// paths (type inference and typed-AST construction), and neither followed
// the generic struct's polymorphic method scheme -- inference read a bogus
// placeholder type recorded at registration time (the impl's own still-
// generic type parameter, not a real concrete type), and construction only
// checked the concrete-impl method_env, missing generic impls entirely. The
// `elem + 1` below fails to typecheck as an integer unless the element type
// is correctly recovered as the receiver's actual instantiation (i64 here),
// not the bogus placeholder.

aspect Iterable<T> {
    fun next(&var self) -> Perhaps<T>;
}

struct Wrapper<T> {
    value: T,
    used: boolean,
}

extend<T: Clone> Wrapper<T>: Iterable<T> {
    fun next(&var self) -> Perhaps<T> {
        if (self.used) {
            return None;
        }
        self.used := true;
        return Perhaps::Some { value = self.value.clone() };
    }
}

fun main() {
    let var w := Wrapper { value = 42, used = false };
    for (x in w) {
        assert(x + 1 == 43);
    }
}
