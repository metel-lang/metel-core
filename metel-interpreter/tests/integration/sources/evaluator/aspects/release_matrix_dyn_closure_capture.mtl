record User { public name: String }
aspect Describe { fun describe(&self) -> String; }
extend User: Describe {
    fun describe(&self) -> String { self.name.clone() }
}

type View := dyn Describe;
type Callback := once || -> String;

fun main() {
    let user := User { name = "captured" };
    let view: View := user;
    let callback: Callback := [view] once || { view.describe() };
    assert(callback() == "captured");
}
