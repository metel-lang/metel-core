// metel-core#1460: `Handle.{ ..R }` names no field of its own, so its tail absorbs the whole
// argument and nothing is forgotten -- the RFC-0121 section 4 forget rule does not apply, exactly
// as it does not for the anonymous `{ ..R }`. A whole struct with a non-`Copy` field passes.
struct Handle { fd: i64, name: String }

fun any_handle<row R>(h: Handle.{ ..R }) -> i64 { 1 }

fun fd_of<row R, row Rest>(h: Handle.{ ..R }) -> i64 where R = { fd: i64, ..Rest } { h.fd }

fun read_fd<row R>(h: Handle.{ fd, ..R }) -> i64 { h.fd }

fun anon<row R>(d: { ..R }) -> i64 { 1 }

fun main() {
    assert(any_handle(Handle { fd = 3, name = "x".to_string() }) == 1);
    assert(fd_of(Handle { fd = 3, name = "x".to_string() }) == 3);
    assert(anon({ fd = 3, name = "x".to_string() }) == 1);

    // a residual with a Copy remainder also passes a named-field projection
    let h := Handle { fd = 5, name = "y".to_string() };
    let n := h.name;
    assert(read_fd(h) == 5);
    assert(n == "y");
}
