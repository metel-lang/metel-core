// RFC-0151 (metel-core#2022): a tuple pattern is allowed in `let`, `var` and `let var`; it is the record pattern
// `.{ .0: x, .1: y }` it desugars to.
fun main() {
    let t := (1, "x");
    let (a, b) := t;
    assert(a == 1);
    assert(b == "x");
    var (c, d) := (2, 3);
    c = c + d;
    assert(c == 5);
    let var (e, _) := (7, 8);
    e = e + 1;
    assert(e == 8);
}
