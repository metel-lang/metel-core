// metel-core#1459, RFC-0191 (metel-core#1867): after a field is moved out, the remaining row is the
// spread's row; a label written next to the spread that the row proves present replaces that field,
// and the others are carried over.
record Tok { value: String, id: i64, n: i64 }

fun main() {
    let b := Tok { value = "y".to_string(), id = 2, n = 3 };
    let a := b.value;
    let r := .{ .id = 9, ..b };
    assert(r.id == 9 && r.n == 3);
    assert(a == "y");
}
