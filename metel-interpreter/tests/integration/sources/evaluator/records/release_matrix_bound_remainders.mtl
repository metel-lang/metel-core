fun duplicate_rest<row R, row Rest>(value: { ..R }) -> ({ ..Rest }, { ..Rest })
where R = { token: String, ..Rest }, all Rest: Copy {
    let { token: _, ..rest } := value;
    let first := rest;
    let second := rest;
    (first, second)
}
aspect Relay { fun pass<T>(self, value: T) -> T; }
struct Courier {}
extend Courier: Relay {
    fun pass<T>(self, value: T) -> T { value }
}
fun extract<T>(value: { payload: T }) -> T {
    let { payload, ..rest } := value;
    let empty: {} := rest;
    payload
}
struct Owned { text: String }
fun forward<T>(value: T) -> T { value }
fun main() {
    assert(extract({ payload = "generic owned" }) == "generic owned");
    assert(extract({ payload = 17 }) == 17);
    let empty_pair := duplicate_rest({ token = "discarded" });
    let left: {} := empty_pair.0;
    let right: {} := empty_pair.1;
    let pair := duplicate_rest({ token = "discarded", count = 8, enabled = true });
    assert(pair.0.count == 8);
    assert(pair.1.enabled);
    let { token: _, ..empty } := { token = "owned" };
    let forwarded: {} := Courier {}.pass(empty);
    let data := { token = "discarded", payload = "kept" };
    let var { token: _, ..tail } := data;
    tail.payload := "restored";
    assert(Courier {}.pass(tail).payload == "restored");
    let owned := Owned { text = "removed" };
    let text := owned.text;
    let forwarded_nominal: Owned.{} := Courier {}.pass(forward(owned));
    assert(text == "removed");
}
