// RFC-0151 step 0 (metel-core#2029): an integer label is a label like any other, so `r.0` on a record is field
// access on `.0`, and it reads, writes and borrows as a named field does.
fun main() {
    var r := .{ .0 = 1, .1 = "a" };
    assert(r.0 == 1);
    assert(r.1 == "a");
    r.0 = 5;
    assert(r.0 == 5);
    let p := &r.0;
    assert(*p == 5);
    let m := &var r.0;
    *m = 6;
    assert(r.0 == 6);
}
