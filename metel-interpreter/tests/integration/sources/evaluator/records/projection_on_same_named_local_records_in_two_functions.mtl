// metel-core#1617 (v0.14.1 integration session): projecting a field out of a block-local record with `.{ }` where another function declares a record of the same name (#1553 x record narrowing).

fun a() -> i64 {
    record P { x: i64, y: i64 }
    let p := P { x = 1, y = 2 };
    let q := p.{ x };
    q.x
}

fun b() -> String {
    record P { x: String, z: String }
    let p := P { x = "a", z = "b" };
    let q := p.{ x };
    q.x
}

fun main() {
    assert(a() == 1);
    assert(b() == "a");
}
