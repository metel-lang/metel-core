struct Pair { left: String, right: String }
type Callback := once var || -> Pair;

fun main() {
    var pair := Pair { left = "old", right = "gone" };
    let left := pair.left;
    let right := pair.right;
    let callback: Callback := [pair] once var || -> Pair {
        pair.left := "new";
        pair.right := "back";
        pair
    };
    assert(callback().left == "new");

    var partial := Pair { left = "gone", right = "kept" };
    let removed := partial.left;
    let restore := [partial] once var || -> Pair {
        partial.left := "restored";
        assert(partial.right == "kept");
        partial
    };
    assert(restore().left == "restored");

    var anonymous := { left = "old", right = "gone" };
    let row_left := anonymous.left;
    let restore_row := [anonymous] once var || -> { right: String } {
        anonymous.right := "back";
        anonymous
    };
    assert(restore_row().right == "back");

    let empty_anonymous := { owned = "gone" };
    let owned := empty_anonymous.owned;
    let empty_callback := [empty_anonymous] once || -> {} { empty_anonymous };
    let empty: {} := empty_callback();
}
