// metel-core#1473 (RFC-0180): a closed literal row, `..{ host: String }`, is exactly those
// fields, and is usable as a binding annotation.
record Req<record R> { data: { ..R } }

fun main() {
    let r: Req<..{ host: String }> := Req { data = { host = "x" } };
    assert(r.data.host == "x");
    let e: Req<..{}> := Req { data = {} };
}
