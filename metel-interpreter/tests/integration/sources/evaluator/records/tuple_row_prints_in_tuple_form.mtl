// RFC-0151: a closed row whose labels are exactly `0 .. N-1` prints as a tuple, `(A,)` for one element and `()` for
// none; any other row, with a gap or an identifier label, prints in brace form.
fun main() {
    assert("${(1, 2)}" == "(1, 2)");
    assert("${(5,)}" == "(5,)");
    assert("${()}" == "()");
    assert("${.{ .a = 1 }}" == ".{ .a: 1 }");
    assert("${.{ .0 = 1, .2 = 3 }}" == ".{ .0: 1, .2: 3 }");
    assert("${((1, 2), 3)}" == "((1, 2), 3)");
}
