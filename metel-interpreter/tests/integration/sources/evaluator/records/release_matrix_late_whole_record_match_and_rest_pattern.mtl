// Whole-record open rows x pattern matching x rest patterns (RFC-0179, RFC-0178): one arm of a
// match destructures the remainder out of the owned parameter, the other leaves it to drop.
fun split<row R>(p: { kind: i64, ..R }) -> i64 {
    match (p.kind) {
        1 => {
            let { kind: _, ..rest } := p;
            10
        },
        _ => 20,
    }
}

fun main() {
    assert(split({ kind = 1, text = "t".to_string() }) == 10);
    assert(split({ kind = 2, text = "u".to_string() }) == 20);
}
