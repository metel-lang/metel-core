// RFC-0151 step 0: a row may mix integer and identifier labels (a call's argument list is such a row); the integer
// labels come first.
fun main() {
    let r := .{ .name = "x", .1 = 2, .0 = 1 };
    assert(r.0 == 1);
    assert(r.1 == 2);
    assert(r.name == "x");
    assert("${r}" == ".{ .0: 1, .1: 2, .name: x }");
}
