// #1945: preserve enum/record interactions after constructor-call rollback.
enum Shape { Rect { w: i64, h: i64 }, Circle { r: i64 } }
fun area(s: Shape) -> i64 {
    match (s) { Shape::Rect { w, h } => w * h, Shape::Circle { r } => 3 * r * r }
}
fun main() {
    let dims := { .w = 2, .h = 5 };
    assert(area(Shape::Rect { w = dims.w, h = dims.h }) == 10);
    assert(area(Shape::Rect { h = 3, w = 4 }) == 12);
}
