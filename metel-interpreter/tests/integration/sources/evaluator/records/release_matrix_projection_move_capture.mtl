// Second rerun (2026-10-15), CL x OW x NR: a projection moves a non-Copy field and keeps the
// brand; a `move` closure then captures the branded value, and the narrowed source still
// serves its Copy field. (metel-core#1455)
struct Handle { fd: i64, name: String }

fun len_of(p: Handle.{ name }) -> i64 { p.name.len() }

fun main() {
    var h := Handle { fd = 7, name = "abc".to_string() };
    let p := h.{ name };
    let f := [p] once || { len_of(p) };
    assert(f() == 3);
    assert(h.fd == 7);
}
