struct Pair { left: String, right: String }
fun main() {
    var pair := Pair { left = "gone", right = "kept" };
    let left := pair.left;
    let repair := [pair] once |extra| { (pair.right, extra) };
    let result := repair(7);
    assert(result.0 == "kept");
    assert(result.1 == 7);

    var empty_pair := Pair { left = "old-left", right = "old-right" };
    let old_left := empty_pair.left;
    let old_right := empty_pair.right;
    let refill := [empty_pair] once var |extra| {
        empty_pair.left := "new-left";
        empty_pair.right := "new-right";
        (empty_pair, extra)
    };
    let restored := refill(9);
    assert(restored.0.left == "new-left");
    assert(restored.0.right == "new-right");
    assert(restored.1 == 9);
}
