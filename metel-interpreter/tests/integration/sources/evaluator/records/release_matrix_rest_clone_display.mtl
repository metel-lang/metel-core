record Item { id: i64, name: String, tags: [String; 2] }
record Token { value: String }
fun clone_rest() {
    let it := Item { id = 1, name = "n", tags = ["a", "b"] };
    let { id, ..rest } := it;
    assert(id == 1);
    let c := rest.clone();
    assert("${c}" == "{ name: n, tags: [a, b] }");
    assert(c.name == rest.name);
}

fun clone_empty() {
    let t := Token { value = "x" };
    let { value: _, ..rest } := t;
    let c := rest.clone();
    assert("${c}" == "{}");
    assert("${rest}" == "{}");
}

fun main() {
    clone_rest();
    clone_empty();
}
