// RFC-0022 §2 (corrected metel-core#750): a braceless `if` with no `else` has
// type Unit, and is not restricted to statement position -- it's usable
// anywhere a Unit-typed expression is, including a `let` binding's
// initializer.
fun main() {
    var calls := 0;
    let calls_ref: &var i64 := &var calls;
    let value := if (true) { *calls_ref += 1; };
    assert(calls == 1);
}
