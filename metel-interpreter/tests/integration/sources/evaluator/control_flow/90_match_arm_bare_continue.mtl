// Issue #229: a match arm using bare `continue` -- not covered by #226's
// return_arm/break_arm grammar exception, since that never included a
// continue_arm; now works via the same unified expression mechanism.
fun sum_evens(n: i64) -> i64 {
    var total: i64 := 0;
    var i: i64 := 0;
    loop {
        if (i == n) { break; }
        i = i + 1;
        match (i % 2) {
            0 => total = total + i,
            _ => continue,
        }
    }
    total
}

fun main() {
    assert(sum_evens(6) == 12);
}
