// ── Struct used throughout ────────────────────────────────────────────────────

struct Counter {
    value: i64,
    step:  i64,
}

extend Counter {
    fun new(step: i64) -> Counter {
        Counter(value = 0, step = step)
    }

    // value receiver: returns a new Counter, does not mutate in place
    fun with_value(&self, n: i64) -> Counter {
        Counter(value = n, step = self.step)
    }

    // &self: read-only, non-consuming
    fun get(&self) -> i64 {
        self.value
    }

    fun is_positive(&self) -> boolean {
        self.value > 0
    }

    // &var self: in-place mutation
    fun tick(&var self) {
        self.value += self.step;
    }

    fun reset(&var self) {
        self.value = 0;
    }

    fun add(&var self, n: i64) {
        self.value += n;
    }
}

// ── Value receiver does not mutate the original ───────────────────────────────

fun test_value_receiver() {
    let c := Counter::new(1);
    let d := c.with_value(42);
    // c is unchanged — value receiver copied it
    assert(c.get() == 0);
    assert(d.get() == 42);
}

// ── &self is non-consuming: can be called repeatedly ─────────────────────────

fun test_ref_receiver_repeated() {
    var c := Counter::new(1);
    c.tick();
    assert(c.is_positive() == true);
    assert(c.get() == 1);
    // calling &self methods does not consume c — still usable
    assert(c.is_positive() == true);
    assert(c.get() == 1);
}

// ── &var self accumulates state across calls ──────────────────────────────────

fun test_mut_receiver_accumulates() {
    var c := Counter::new(3);
    c.tick();          // 3
    c.tick();          // 6
    c.tick();          // 9
    assert(c.get() == 9);
    c.reset();
    assert(c.get() == 0);
    c.add(100);
    assert(c.get() == 100);
}

// ── &self and &var self interleaved ───────────────────────────────────────────

fun test_interleaved_receivers() {
    var c := Counter::new(10);
    assert(c.get() == 0);
    c.tick();
    assert(c.get() == 10);
    assert(c.is_positive() == true);
    c.tick();
    assert(c.get() == 20);
    c.reset();
    assert(c.get() == 0);
    assert(c.is_positive() == false);
}

// ── Calling through a &T reference (auto-deref, &self methods) ─────────────────

fun test_ref_through_pointer() {
    var c := Counter::new(1);
    c.tick();
    c.tick();
    let p: &Counter := &c;
    // &self method accessible through &T
    assert(p.get() == 2);
    assert(p.is_positive() == true);
}

// ── Calling through a &var T reference (auto-deref, &var self methods) ─────────

fun test_mut_ref_through_mut_pointer() {
    var c := Counter::new(5);
    let p: &var Counter := &var c;
    p.tick();          // 5
    p.tick();          // 10
    assert(c.get() == 10);
    p.add(3);
    assert(c.get() == 13);
}

// ── Reference and direct call see the same storage ─────────────────────────────

fun test_pointer_and_direct_share_storage() {
    var c := Counter::new(1);
    let p: &var Counter := &var c;
    p.tick();          // p increments through the pointer
    c.tick();          // direct call increments same counter
    assert(c.get() == 2);
    assert(p.get() == 2);
}

// ── Builder pattern: chained value receivers ─────────────────────────────────

struct Builder {
    x: i64,
    y: i64,
    label: String,
}

extend Builder {
    fun new() -> Builder {
        Builder(x = 0, y = 0, label = "")
    }

    fun set_x(self, x: i64) -> Builder {
        Builder(x = x, y = self.y, label = self.label)
    }

    fun set_y(self, y: i64) -> Builder {
        Builder(x = self.x, y = y, label = self.label)
    }

    fun sum(&self) -> i64 {
        self.x + self.y
    }
}

fun test_builder_pattern() {
    let b := Builder::new().set_x(3).set_y(7);
    assert(b.sum() == 10);
    assert(b.x == 3);
    assert(b.y == 7);
}

// ── Multiple pointers to independent counters ────────────────────────────────

fun test_independent_pointers() {
    var a := Counter::new(1);
    var b := Counter::new(10);
    let pa: &var Counter := &var a;
    let pb: &var Counter := &var b;
    pa.tick();
    pb.tick();
    pb.tick();
    assert(a.get() == 1);
    assert(b.get() == 20);
}

fun main() {
    test_value_receiver();
    test_ref_receiver_repeated();
    test_mut_receiver_accumulates();
    test_interleaved_receivers();
    test_ref_through_pointer();
    test_mut_ref_through_mut_pointer();
    test_pointer_and_direct_share_storage();
    test_builder_pattern();
    test_independent_pointers();
}
