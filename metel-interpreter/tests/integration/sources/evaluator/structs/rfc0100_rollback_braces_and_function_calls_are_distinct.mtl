// metel-core#1945: nominal braces resolve a type; calls resolve a value.
struct Ticket { value: i64 }
fun Ticket(input: i64) -> i64 { input + 100 }
fun add(left: i64, right: i64) -> i64 { left + right }
fun main() {
    let value := 3;
    let ticket := Ticket { value };
    assert(ticket.value == 3);
    assert(Ticket(input = 1) == 101);
    assert(add(right = 2, left = 1) == 3);
    let row := { .value = ticket.value };
    assert(row.value == 3);
}
