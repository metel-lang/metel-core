// RFC-0121 item 2 (metel-core#1310): an `extend` block may splice its own row
// generic into the target (`Session<..R>`), whatever the impl calls it, and its
// methods dispatch for every instantiation. With a `where R = { .., ..Rest }`
// equation the method's result row is derived from the receiver's. The
// derived and reverse-extension bodies are executed, including an empty tail.

record Session<row R> { public id: i64, public data: { ..R } }

extend<row R> Session<..R> {
    fun ident(self) -> i64 { self.id }
}

// The impl names its row generic `Q`, not the struct's own `R`.
extend<row Q> Session<..Q> {
    fun doubled(self) -> i64 { self.id * 2 }
}

extend<row R, row Rest> Session<..R> where R = { token: String, ..Rest } {
    fun authenticate(self) -> Session<..Rest> {
        let { id, data } := self;
        let { token: _, ..rest } := data;
        Session { id = id, data = rest }
    }
}

extend<row R: !{token}> Session<..R> {
    fun with_token(self, token: String) -> Session<{ token: String, ..R }> {
        let { id, data } := self;
        Session { id = id, data = { token = token, ..data } }
    }
}

fun main() {
    let s: Session<{ token: String, extra: i64 }> :=
        Session { id = 7, data = { token = "t", extra = 2 } };
    assert(s.ident() == 7);
    assert(s.doubled() == 14);

    let bare: Session<{ extra: i64 }> := Session { id = 3, data = { extra = 1 } };
    assert(bare.ident() == 3);

    let r := s.authenticate();
    assert(r.data.extra == 2);
    assert(r.id == 7);
    let annotated: Session<{ extra: i64 }> := bare.with_token("new").authenticate();
    assert(annotated.id == 3);
    assert(annotated.data.extra == 1);
    let empty: Session<{}> := Session { id = 9, data = {} };
    let empty_again: Session<{}> := empty.with_token("empty").authenticate();
    assert(empty_again.id == 9);
    let owned := Session { id = 11, data = { name = "Ada" } };
    assert(owned.with_token("owned").authenticate().data.name == "Ada");
    println("ok");
}
