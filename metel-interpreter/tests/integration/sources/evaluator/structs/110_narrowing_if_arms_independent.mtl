// metel-core#958: row-narrowing move state is path-sensitive across `if` arms.
// Both arms move the same non-`Copy` field out of `rec`; the `else` arm does
// not see the `then` arm's move, so each is an independent partial move. After
// the `if` the arms join: `rec` is narrowed to `{ keep: i64 }` on every path,
// its surviving field stays readable, and a whole-value use at the narrowed
// row is accepted (also under --move-check).
fun keep_of(r: { .keep: i64 }) -> i64 { r.keep }

fun main() {
    let cond := true;
    let rec := { .gone = "x".to_string(), .keep = 3 };
    if (cond) {
        let a := rec.gone;
        assert(a == "x");
    } else {
        let b := rec.gone;
        assert(b == "x");
    }
    assert(rec.keep == 3);          // surviving field readable at the joined row
    assert(keep_of(rec) == 3);      // whole value fits the narrowed row
    println("ok");
}
