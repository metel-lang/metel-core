// RFC-0100 section 8 (metel-core#1860): the arguments of a construction call evaluate left to right as
// written, positional or keyword, and only then fill the fields.
struct Counter { n: i64 }

extend Counter {
    fun next(&var self) -> i64 {
        self.n = self.n + 1;
        self.n
    }
}

struct Pair { a: i64, b: i64 }

fun main() {
    var c := Counter(0);
    let p := Pair(b = c.next(), a = c.next());
    assert(p.b == 1 && p.a == 2);
    let q := Pair(c.next(), c.next());
    assert(q.a == 3 && q.b == 4);
}
