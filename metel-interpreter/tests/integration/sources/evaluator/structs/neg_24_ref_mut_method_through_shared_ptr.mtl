// TYPECHECK_ERROR[T0006]
// Calling a &var self method through a &T (immutable) reference is rejected.

struct Counter {
    value: i64,
}

extend Counter {
    fun increment(&var self) {
        self.value += 1;
    }
}

fun main() {
    var c := Counter { value = 0 };
    let p: &Counter := &c;
    p.increment();
}
