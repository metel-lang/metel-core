// metel-core#1585: a user enum named `Option` shadows the core one in this module, but a
// `Option` value that comes from std is matched against its own declaration, not the spelling.
import std::env::get;

enum Option<T> {
    Nope,
}

fun main() {
    let found := match (get("METEL_1585_NOT_SET")) {
        Some { value } => { value },
        None => { "unset" },
    };
    assert(found == "unset");
}
