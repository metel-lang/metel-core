// Anonymous record fields may be written in any order in both the type
// annotation and the literal, and the same record participates in a
// call/return round trip and a `match` destructuring pattern.
fun take(p: { .y: i64, .x: i64 }) -> { .y: i64, .x: i64 } {
    ({ .y = p.y, .x = p.x })
}

fun main() {
    let point := { .y = 2, .x = 1 };
    let swapped := take(point);
    assert(swapped.x == 1);
    assert(swapped.y == 2);

    let sum := match (point) { { .y, .x } => x + y, };
    assert(sum == 3);
}
