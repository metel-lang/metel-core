// RFC-0121 sec3: the decomposition's own remainder can be anonymous too
// (`where R = { extra: i64, .. }`), exactly as an open row tail's remainder
// can be anonymous at the other use sites.

fun split<row R>(p: { token: i64, ..R }) -> i64
where R = { extra: i64, .. }
{
    p.token + p.extra
}

fun main() {
    let r := { token = 1, extra = 2 };
    assert(split(r) == 3);
    println("ok");
}
