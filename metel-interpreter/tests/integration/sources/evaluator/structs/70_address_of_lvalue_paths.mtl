// Tests that & can be applied to arbitrary lvalue paths:
// field access, tuple element access, array index, and chained paths.

// ── Field access ──────────────────────────────────────────────────────────────

struct Point {
    x: i64,
    y: i64,
}

fun test_field_address_of() {
    let p := Point { x = 3, y = 7 };
    let px: &i64 := &p.x;
    let py: &i64 := &p.y;
    assert(*px == 3);
    assert(*py == 7);
}

// ── Tuple element access ──────────────────────────────────────────────────────

fun test_tuple_address_of() {
    let t := (10, 20, 30);
    let p0: &i64 := &t.0;
    let p1: &i64 := &t.1;
    let p2: &i64 := &t.2;
    assert(*p0 == 10);
    assert(*p1 == 20);
    assert(*p2 == 30);
}

// ── Array index ───────────────────────────────────────────────────────────────

fun test_array_index_address_of() {
    let arr := [1, 2, 3, 4, 5];
    let p: &i64 := &arr[2];
    assert(*p == 3);
}

// ── Chained path: field of a field ───────────────────────────────────────────

struct Pair {
    a: Point,
    b: Point,
}

fun test_chained_field_address_of() {
    let pair := Pair {
        a = Point { x = 1, y = 2 },
        b = Point { x = 10, y = 20 },
    };
    let pax: &i64 := &pair.a.x;
    let pby: &i64 := &pair.b.y;
    assert(*pax == 1);
    assert(*pby == 20);
}

// ── Tuple of tuples ───────────────────────────────────────────────────────────

fun test_nested_tuple_address_of() {
    let t := ((1, 2), (3, 4));
    let p: &i64 := &t.1.0;
    assert(*p == 3);
}

// ── Function reference from tuple element ────────────────────────────────────

fun apply_fns(fns: Array<&var var || -> ()>) {
    for (f in fns) {
        f();
    }
}

fun test_fn_ptr_from_tuple() {
    var counter := 0;
    var ptr := &var counter;
    var inc := [&var ptr] var || -> () { *ptr += 1; };
    var ops := (inc, inc);
    apply_fns([&var ops.0, &var ops.1]);
    assert(counter == 2);
}

// ── &T passed to function ─────────────────────────────────────────────────────

fun sum_pair(a: &i64, b: &i64) -> i64 {
    *a + *b
}

fun test_field_ptr_as_arg() {
    let p := Point { x = 5, y = 8 };
    let result := sum_pair(&p.x, &p.y);
    assert(result == 13);
}

fun main() {
    test_field_address_of();
    test_tuple_address_of();
    test_array_index_address_of();
    test_chained_field_address_of();
    test_nested_tuple_address_of();
    test_fn_ptr_from_tuple();
    test_field_ptr_as_arg();
}
