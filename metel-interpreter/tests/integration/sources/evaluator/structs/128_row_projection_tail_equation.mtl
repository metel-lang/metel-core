// RFC-0121 §2 (metel-core#1306 item 7): a `where R = { label: T, ..Rest }` equation
// on a residual-projection tail (`Handle.{ fd, ..R }`) requires the equation's fields,
// as it does on a record tail, and they count as kept by the width-subtyping check
// (so a non-`Copy` field the equation names is not "forgotten").

struct Handle { public fd: i64, public extra: String }

fun use_it<row R, row Rest>(h: Handle.{ fd, ..R }) -> i64
where R = { extra: String, ..Rest } {
    h.fd
}

fun main() {
    let h := Handle { fd = 7, extra = "e" };
    assert(use_it(h) == 7);
    println("ok");
}
