// RFC-0121 §2 (metel-core#1310): in `where R = { token: String, ..Rest }`, `Rest`
// *is* `R` with `token` removed. A call derives it, so the result keeps `extra`
// and the annotation `Session<{ extra: i64 }>` is accepted. The body is
// `panic`, so the call is guarded: this checks the types, it never runs it.

record Session<record R> { id: i64, data: { ..R } }

fun authenticate<record R, record Rest>(s: Session<..R>) -> Session<..Rest>
where R = { token: String, ..Rest } {
    panic("unimplemented")
}

fun main() {
    if (false) {
        let s: Session<{ token: String, extra: i64 }> :=
            Session { id = 1, data = { token = "t", extra = 2 } };
        let r := authenticate(s);
        assert(r.data.extra == 2);
        let s2: Session<{ token: String, extra: i64 }> :=
            Session { id = 1, data = { token = "t", extra = 2 } };
        let annotated: Session<{ extra: i64 }> := authenticate(s2);
        assert(annotated.id == 1);
    }
    println("ok");
}
