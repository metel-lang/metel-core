// RFC-0121 item 2 (metel-core#1310): a `row`-kinded generic parameter on a
// nominal type takes a closed record type as its argument; `Builder<..R>`
// splices the row variable, and a `where R = { .. }` equation bounds it.

record Builder<record R> { name: String, data: { ..R } }

struct Tagged<T, record R> { public v: T, public extra: { ..R } }

fun describe<record R>(b: Builder<..R>) -> String { b.name }

fun auth_of<record R>(b: Builder<..R>) -> String where R = { auth: String, .. } {
    b.data.auth
}

fun get<T, record R>(t: Tagged<T, ..R>) -> T { t.v }

fun main() {
    let b := Builder { name = "req", data = { auth = "tok", retries = 3 } };
    assert(auth_of(b) == "tok");
    assert(describe(Builder { name = "req", data = { auth = "tok", retries = 3 } }) == "req");

    let c: Builder<{ auth: String }> := Builder { name = "c", data = { auth = "t2" } };
    assert(auth_of(c) == "t2");

    let t: Tagged<{ x: i64 }, { note: String }> :=
        Tagged { v = { x = 1 }, extra = { note = "n" } };
    assert(get(t).x == 1);
    println("ok");
}
