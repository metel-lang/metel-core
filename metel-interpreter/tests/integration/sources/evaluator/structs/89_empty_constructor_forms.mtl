// A zero-field struct is the same value by call or (inside its own `extend` block, RFC-0100
// section 3) as a field-less brace literal; a zero-field variant also bare (`Flag::On`).
struct Empty {}

enum Flag {
    On {},
}

extend Empty {
    fun by_brace() -> Empty { Empty {} }
}

extend Flag {
    fun by_brace() -> Flag { Flag::On {} }
}

fun use_empty(x: Empty) -> i64 {
    1
}

fun use_flag(f: Flag) -> i64 {
    match (f) {
        Flag::On => 7,
    }
}

fun main() {
    let b := Empty();
    let c := Empty::by_brace();
    let x := Flag::On;
    let y := Flag::On();
    let z := Flag::by_brace();

    assert(use_empty(b) == 1);
    assert(use_empty(c) == 1);
    assert(use_flag(x) == 7);
    assert(use_flag(y) == 7);
    assert(use_flag(z) == 7);
}
