// Field assignment through a &var reference — auto-deref field access.
struct Point { x: i64, y: i64 }
struct Outer { inner: Point }

fun main() {
    var p := Point { x = 1, y = 2 };
    let ptr: &var Point := &var p;

    // Auto-deref field assign through &var Point.
    ptr.x = 10;
    assert(p.x == 10);

    ptr.y += 8;
    assert(p.y == 10);

    ptr.x = 99;
    assert(p.x == 99);

    ptr.y += 1;
    assert(p.y == 11);

    // Nested struct behind a &var reference.
    var o := Outer { inner = Point { x = 0, y = 0 } };
    let optr: &var Outer := &var o;
    optr.inner.x = 42;
    assert(o.inner.x == 42);
}
