// RFC-0071 §2 `Copy` eligibility through a *generic* field type whose own
// `Copy` impl is conditional (issue #303).
//
// Deciding `extend<T: Copy> Outer<T>: Copy` means answering whether the field
// type `Inner<T>` is `Copy` — a question with no answer in terms of concrete
// types, since `T` is not one. It is answerable under the impl's own bounds:
// `T` is assumed `Copy`, which discharges the bound on `Inner`'s conditional
// impl. The eligibility check used to give up here and reject the program.

copy struct Inner<T> {
    value: T,
}

copy struct Outer<T> {
    inner: Inner<T>,
}

// The same shape with the field through a conditional `Copy` type, written with the class keyword.
copy struct Wrapped<T> {
    held: Inner<T>,
}

// And through an enum payload, which takes the other branch of the check.
copy enum Held<T> {
    One { value: Inner<T> },
    None,
}

fun id<T: Copy>(x: T) -> T {
    return x;
}

fun main() {
    let o := Outer { inner = Inner { value = 1 } };
    let copied := id(o);
    assert(copied.inner.value == 1);

    let w := Wrapped { held = Inner { value = 2 } };
    let w_copied := id(w);
    assert(w_copied.held.value == 2);

    let h := Held::One { value = Inner { value = 3 } };
    let h_copied := id(h);
    match (h_copied) {
        Held::One { value } => assert(value.value == 3),
        Held::None => assert(false),
    }
}
