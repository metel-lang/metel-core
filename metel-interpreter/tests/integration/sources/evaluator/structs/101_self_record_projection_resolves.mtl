// #774: `Self` resolves inside a record projection (`Self.{ field }`) exactly as
// it does as a plain type in the same position -- confirmed by writing the same
// method both ways and getting the same result from the same shaped argument.
// Before the fix, only the `Handle.{ fd }` (concrete-name) spelling resolved;
// `Self.{ fd }` failed with "unknown type `Self`" during the eager
// projections-validity pass, and -- once that pass no longer masked it -- a
// second, independent gap in the real signature resolution (no registry access
// at the one place `Self` alone already had a target name to resolve against)
// surfaced right behind it.
//
// Called with `h.{ fd }` -- RFC-0116's expression-position projection, which
// evaluates the real `Handle` value and extracts a genuine `{ fd: i64 }` record
// from it -- rather than a bare `Handle` value. A parameter typed `Self.{ fd }`/
// `Handle.{ fd }` intentionally does not accept a bare struct value: no implicit
// struct-to-record coercion exists anywhere (RFC-0118's already-shipped row-bound
// rule is the same principle: "only a record satisfies a row bound; a nominal
// struct is rejected even when it has matching fields"). `.{ fd }` is the
// explicit, already-implemented way to produce the narrower value the parameter
// asks for -- not a workaround, the intended pairing.

struct Handle { fd: i64, name: String }

extend Handle {
    fun describe_self(h: Self.{ .fd }) -> i64 {
        return h.fd;
    }
    fun describe_named(h: Handle.{ .fd }) -> i64 {
        return h.fd;
    }
}

fun main() {
    let h := Handle { fd = 3, name = "stdin" };
    assert(Handle::describe_self(h.{ .fd }) == 3);
    assert(Handle::describe_named(h.{ .fd }) == 3);
}
