// metel-core#1577: a bare name in expression position is looked up in the value namespace first and
// then in the type namespace. `Unit` has no value of its name, so it is the zero-field struct.
//
// metel-core#2198 (RFC-0100): this fixture previously also covered `Both`, a struct and a function
// of one name, to show the bare call finding the function while the literal built the struct -- a
// type and a value may no longer share a name, so that example moved to
// neg_struct_and_function_of_one_name_is_t0037.mtl instead of being dropped silently.
struct Unit {}

fun main() {
    let u := Unit;
    let v := Unit();
}
