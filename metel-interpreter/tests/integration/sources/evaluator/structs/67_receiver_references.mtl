struct Counter {
    value: i64,
}

extend Counter {
    fun increment(&var self) {
        self.value += 1;
    }

    fun current(&self) -> i64 {
        self.value
    }
}

fun main() {
    var counter := Counter { value = 0 };
    counter.increment();
    counter.increment();
    assert(counter.current() == 2);
}
