// metel-core#1615: a type declared in an inner block shadows the module-level type only inside that block.
struct P { x: i64 }

fun main() {
    if (true) {
        struct P { y: i64 }
        let inner := P { y = 2 };
        assert(inner.y == 2);
    }
    let outer := P { x = 1 };
    assert(outer.x == 1);
}
