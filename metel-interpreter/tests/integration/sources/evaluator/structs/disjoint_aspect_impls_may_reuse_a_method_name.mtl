// metel-core#1229: the duplicate-method rule is per block, so two aspect impls for different
// instantiations of one generic type may each define `t`, and each receiver gets its own.
aspect Tag { fun t(&self) -> i64; }
struct W<T> { v: T }
extend W<i64>: Tag { fun t(&self) -> i64 { 1 } }
extend W<String>: Tag { fun t(&self) -> i64 { 2 } }
fun main() {
    let a := W { v = 1 };
    let b := W { v = "s" };
    assert(a.t() == 1);
    assert(b.t() == 2);
}
