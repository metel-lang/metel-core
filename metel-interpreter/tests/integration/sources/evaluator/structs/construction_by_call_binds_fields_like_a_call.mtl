// RFC-0100 section 1 (metel-core#1860): a struct is built by a call. Positional arguments bind the
// fields in declaration order, keyword arguments (RFC-0223) bind by name in any order.
struct Point { pub x: i64, pub y: i64 }
struct Empty {}
struct Pair<T> { first: T, second: T }

extend Point {
    fun origin() -> Point { Self(0, 0) }
    fun shifted(&self, d: i64) -> Point { Self(x = self.x + d, y = self.y) }
}

fun main() {
    let a := Point(1, 2);
    let b := Point(x = 1, y = 2);
    let c := Point(y = 2, x = 1);
    assert(a.x == b.x && b.y == c.y && c.x == 1);
    assert(Point::origin().shifted(3).x == 3);

    let e1 := Empty;
    let e2 := Empty();
    assert(true);

    let p := Pair(1, 2);
    let q := Pair::<i64>(3, 4);
    assert(p.first + q.second == 5);
}
