// RFC-0121 sec3: a decomposition equation with no tail at all is pointless
// -- identical to an ordinary bound -- so the grammar accepts a bare
// `type_expr` right-hand side (matching the RFC's own literal production)
// only to reject it explicitly at parse time, rather than silently failing
// to match the `row_equation` rule.

fun split<row R>(p: { token: i64, ..R }) -> i64
where R = i64
{
    p.token
}

fun main() {}
