// RFC-0225 leaves nominal declarations and construction, field selection, floats and ranges as they are.
struct Handle { fd: i64, name: String }
fun fd(h: Handle) -> i64 { h.fd }
fun main() {
    let h := Handle { fd = 1, name = "a".to_string() };
    let f := 1.5;
    let r := 0..3;
    let n := h.fd;
    assert(fd(h) == 1);
    println("ok");
}
