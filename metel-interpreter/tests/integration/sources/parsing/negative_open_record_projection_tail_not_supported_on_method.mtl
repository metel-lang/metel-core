// RFC-0121 (Open Rows, metel-core#1301): a struct's own residual-projection
// tail is grammar-legal on a method too (`extend` blocks reuse `fun_decl`'s
// own param list), but this installment's structural resolution only runs
// for a plain free function -- rejected explicitly at parse time, exactly
// like sec1's generic open-row-tailed record parameter.

struct Handle { fd: i64 }

extend Handle {
    fun get_fd<row R>(self, extra: Handle.{ fd, ..R }) -> i64 { extra.fd }
}

fun main() {}
