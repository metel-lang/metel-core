public record LeftPacket<record R> { data: { ..R } }
public aspect LeftRead { fun read(&self) -> i64; }
extend<record R: { count: i64, .. }> LeftPacket<..R>: LeftRead {
    fun read(&self) -> i64 { self.data.count }
}
public fun inspect_left<record R: { count: i64, .. }>(packet: &LeftPacket<..R>) -> i64 {
    packet.read()
}
public fun identity_left<record R>(packet: LeftPacket<..R>) -> LeftPacket<..R> { packet }
