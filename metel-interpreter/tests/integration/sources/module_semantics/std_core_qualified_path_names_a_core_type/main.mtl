// metel-core#1587: the explicit `std::core::` path names a core type in a type position, also where
// the module declares a type of the same name.
enum Perhaps<T> {
    Nope,
}

fun first(values: [i64]) -> std::core::Perhaps<i64> {
    if (values.len() == 0) {
        return None;
    }
    Some { value = values[0] }
}

fun main() {
    let got := match (first([4, 5])) {
        Some { value } => { value },
        None => { 0 },
    };
    assert(got == 4);
}
