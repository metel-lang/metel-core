// metel-core#1715: an imported generic struct is built with different type arguments. Its declared type
// parameters come from the importing module's generator range; fresh variables for them used to reuse a
// declared variable's number, which collapsed the parameters into one and made the first mixed literal
// `cannot unify an integer literal with String`.
import lib::{Pair, swap};

fun main() {
    var p := Pair { first = 5, second = "hello" };
    assert(p.first == 5);
    assert(p.second == "hello");

    let q := Pair { first = true, second = 2.5 };
    assert(q.first);

    let flipped := swap(p);
    assert(flipped.first == "hello");
    assert(flipped.second == 5);

    p.first := 6;
    assert(p.first == 6);
}
