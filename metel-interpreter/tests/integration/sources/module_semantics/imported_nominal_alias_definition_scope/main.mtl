import facade::EmptyPacket as Envelope;
import facade::NumericBox as Container;
import model::{make_packet, make_box};

record Packet { public id: String }
struct Box { public value: String }
fun inspect_packet(packet: Envelope) -> i64 { packet.id }
fun inspect_box(value: Container) -> i64 { value.value }

fun main() {
    assert(inspect_packet(make_packet()) == 7);
    assert(inspect_box(make_box()) == 9);
    assert(Packet { id = "local" }.id == "local");
    assert(Box { value = "local" }.value == "local");
}
