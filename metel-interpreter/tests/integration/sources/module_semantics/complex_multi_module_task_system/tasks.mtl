
import types::*;
import utils::*;

public fun validate_task(title: String, priority: Priority, status: Status, effort: i64) -> Result<Task, ValidationError> {
    if ((&title).len() == 0) {
        return Result::Err { error = ValidationError { message = "title cannot be empty" } };
    }
    if (effort < 0) {
        return Result::Err { error = ValidationError { message = "effort cannot be negative" } };
    }
    Result::Ok { value = Task { title = title, priority = priority, status = status, effort = effort } }
}

public fun total_effort(tasks: [Task]) -> i64 {
    fold_left(tasks, 0, |acc: i64, t: &Task| -> i64 { acc + (*t).effort })
}

public fun open_task_count(tasks: [Task]) -> i64 {
    var count := 0;
    for (t in tasks) {
        match (t.status) {
            Status::Open       => { count += 1; },
            Status::InProgress => { count += 1; },
            Status::Done       => (),
        };
    }
    count
}

public fun is_high_priority(t: &Task) -> boolean {
    match (t.priority) {
        Priority::High   => true,
        Priority::Medium => false,
        Priority::Low    => false,
    }
}

public fun is_high_priority_ref(t: &Task) -> boolean {
    match (t.priority) {
        Priority::High   => true,
        Priority::Medium => false,
        Priority::Low    => false,
    }
}

public fun is_done(t: &Task) -> boolean {
    match (t.status) {
        Status::Done       => true,
        Status::Open       => false,
        Status::InProgress => false,
    }
}

public fun is_done_2(t: &Task) -> boolean {
    match (t.status) {
        Status::Done       => true,
        Status::Open       => false,
        Status::InProgress => false,
    }
}

public fun is_done_ref(t: &Task) -> boolean {
    match (t.status) {
        Status::Done       => true,
        Status::Open       => false,
        Status::InProgress => false,
    }
}

public fun task_titles(tasks: [Task]) -> [String] {
    map_array(tasks, |t: &Task| -> String { (*t).title.substring(0, (*t).title.len()) })
}

public fun find_by_title(tasks: [Task], title: String) -> Perhaps<Task> {
    find_first(
        tasks,
        [&title] |t: &Task| -> boolean { (*t).title == title },
        clone_task,
    )
}

public fun compute_completion_pct(tasks: [Task]) -> i64 {
    let n := tasks.len();
    if (n == 0) { return 0; }
    var done := 0;
    for (t in tasks) {
        if (is_done(&t)) { done += 1; }
    }
    (done * 100) / n
}
