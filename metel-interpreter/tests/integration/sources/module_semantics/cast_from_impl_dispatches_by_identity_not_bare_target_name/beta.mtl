public struct Box { public degrees: f64 }
aspect From<T> { fun from(value: T) -> Self; }
public struct Source { public degrees: f64 }
extend Box: From<Source> {
    fun from(value: Source) -> Box { Box { degrees = value.degrees + 2000.0 } }
}
public fun make_source(d: f64) -> Source { Source { degrees = d } }
