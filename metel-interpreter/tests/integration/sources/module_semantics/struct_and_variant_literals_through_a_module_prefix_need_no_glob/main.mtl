// metel-core#1772: a struct or fieldful-variant literal written with a module prefix resolves by the type the
// prefix names, as a unit variant or a static method does, without a glob import.
import lib::double;
import lib::payload;

fun main() {
    let c := lib::Counter { n = 2 };
    assert(double(c.n) == 4);
    let b := lib::Kind::B { n = 5 };
    assert(payload(b) == 5);
    let r := root::lib::Counter { n = 7 };
    assert(r.n == 7);
    assert(payload(lib::Kind::A) == 0);
}
