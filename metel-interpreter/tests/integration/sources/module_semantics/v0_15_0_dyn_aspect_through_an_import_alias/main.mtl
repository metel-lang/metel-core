// metel-core#1223: a `dyn` type written with an aspect imported `as Alias` names the declared aspect, so
// its methods are found.
import root::shapes::Shape as Sh;
import root::shapes::Sq;
fun total(x: &dyn Sh) -> i64 { x.area() }
fun main() {
    let s := Sq { s = 3 };
    let d: &dyn Sh := &s;
    assert(total(&s) == 9);
    assert(d.area() == 9);
}
