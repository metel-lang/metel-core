// std::env host module (METEL-164): explicit import, read-only environment
// inspection. Deterministic — does not assume any particular variable is set.
import std::env::{get, vars, EnvVar};

fun main() {
    // A name that should not exist in any test environment resolves to None.
    assert(get("METEL_DEFINITELY_UNSET_9z8y7x").is_none());

// vars() yields a [EnvVar]; List ergonomics apply after List::from, and
    // mapping preserves the element count.
    let all := vars();
    let names := List::from(all).map(|e: EnvVar| -> String { e.name });
    assert(names.len() == all.len());

    println("ok");
}
