#!/bin/sh
# metel-core#1268: heavier local checks, once per push rather than per commit.
#
# See pre-commit's comment: git sets GIT_DIR/etc. for hook invocations, and
# it leaks into anything spawned here. Unset defensively -- the merge-commit
# check below reads *this* repo's own history on purpose (via the `git
# rev-list` calls further down, run without -C so they still target the
# right repo once GIT_DIR no longer overrides it).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

set -e

# git passes one line per pushed ref on stdin; read it once, the checks below both need it.
refs=$(cat)

# A push that changes only the docs pin, ROADMAP.md, the process documents or docs/ cannot change what clippy
# and the test suite check (about ten minutes), so they are skipped; CI still runs everything on the pull
# request. METEL_PREPUSH_FULL=1 forces the full run. See tools/push_scope.py for the exact set of paths.
scope=$(printf '%s\n' "$refs" | python3 tools/push_scope.py)
if [ "$scope" = "docs-only" ] && [ -z "${METEL_PREPUSH_FULL:-}" ]; then
    echo "pre-push: docs-only push (docs pin, ROADMAP.md, process documents), skipping clippy and cargo test"
else
    echo "pre-push: cargo clippy --workspace --lib -- -D warnings -D clippy::pedantic"
    cargo clippy --workspace --lib -- -D warnings -D clippy::pedantic

    echo "pre-push: cargo test --workspace"
    cargo test --workspace
fi

echo "pre-push: no flat module file beside its own directory"
python3 tools/check_no_flat_module_dir_collision.py --check
python3 tools/check_no_copy_by_name.py --check

# AGENTS.md: develop's history is linear -- pull requests are rebase-merged, so a
# merge commit never lands on it. This catches a merge commit in a local push to
# develop before the push even leaves the machine.
zero="0000000000000000000000000000000000000000"
printf '%s\n' "$refs" | while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/develop" ] || continue
    [ "$local_sha" = "$zero" ] && continue  # a delete, nothing to check

    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi

    merges=$(git rev-list --merges "$range" 2>/dev/null || true)
    if [ -n "$merges" ]; then
        echo "pre-push: refused -- merge commit(s) in this push to develop:" >&2
        echo "$merges" >&2
        echo "AGENTS.md requires develop to stay linear (rebase-merge the pull request), never a merge commit." >&2
        echo "See 'GitHub and branch workflow' in AGENTS.md for the correct procedure." >&2
        exit 1
    fi
done
